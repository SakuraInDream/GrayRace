<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>AmmoShotgunRail</defName>
		<label>Rail Shotgun</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRailgunRifle</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_ShotgunRail</defName>
		<label>Rail Shotgun</label>
		<ammoTypes>
			<Ammo_ShotgunRail>Bullet_ShotgunRail</Ammo_ShotgunRail>
			<Ammo_ShotgunRail_Slug>Bullet_ShotgunRail_Slug</Ammo_ShotgunRail_Slug>
		</ammoTypes>
		<similarTo>AmmoSet_ChargedShotgun</similarTo>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="ShotgunRailBase" ParentName="SpacerAmmoBase" Abstract="True">
		<description>Multi-pellet charge shot cartridge designed for shotgun-type weapons.</description>
		<statBases>
			<Mass>0.04</Mass>
			<Bulk>0.05</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoShotgunRail</li>
		</thingCategories>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="ShotgunRailBase">
		<defName>Ammo_ShotgunRail</defName>
		<label>Rail shotgun</label>
		<graphicData>
			<texPath>Things/Ammo/Railgun/Pistol</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>BuckShot</ammoClass>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="ShotgunRailBase">
		<defName>Ammo_ShotgunRail_Slug</defName>
		<label>Rail shotgun (Slug)</label>
		<graphicData>
			<texPath>Things/Ammo/Railgun/HighCaliber</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.04</Mass>
		</statBases>
		<ammoClass>Slug</ammoClass>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base12GaugeChargedBullet" ParentName="BaseBulletCE" Abstract="true">
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>GR_NanoBullet</damageDef>
			<speed>180</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base12GaugeChargedBullet">
		<defName>Bullet_ShotgunRail</defName>
		<label>Rail shotgun pellet</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>15</damageAmountBase>
			<armorPenetrationSharp>16</armorPenetrationSharp>
			<armorPenetrationBlunt>44.44</armorPenetrationBlunt>
			<pelletCount>8</pelletCount>
			<spreadMult>14.5</spreadMult>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base12GaugeChargedBullet">
		<defName>Bullet_ShotgunRail_Slug</defName>
		<label>Rail shotgun (Slug)</label>
		<graphicData>
			<drawSize>(1.5,1.5)</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>40</damageAmountBase>
			<armorPenetrationSharp>24</armorPenetrationSharp>
			<armorPenetrationBlunt>190</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="ChargeAmmoRecipeBase">
		<defName>MakeAmmo_ShotgunRail</defName>
		<label>make Rail shotgun shell x200</label>
		<description>Craft 200 Rail shotgun shells.</description>
		<jobString>Making Rail shotgun shells.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Uranium</li>
				<li>Steel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_ShotgunRail>200</Ammo_ShotgunRail>
		</products>
		<workAmount>1000</workAmount>
	</RecipeDef>

	<RecipeDef ParentName="ChargeAmmoRecipeBase">
		<defName>MakeAmmo_ShotgunRail_Slug</defName>
		<label>make Rail shotgun (Slug) shell x200</label>
		<description>Craft 200 Rail shotgun (Slug) shells.</description>
		<jobString>Making Rail shotgun (Slug) shells.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Uranium</li>
				<li>Steel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_ShotgunRail_Slug>200</Ammo_ShotgunRail_Slug>
		</products>
		<workAmount>1000</workAmount>
	</RecipeDef>

</Defs>