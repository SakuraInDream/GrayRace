<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>AmmoGrayRailgun</defName>
		<label>Gray Railgun</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRailgunHighCaliber</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_PDW_Railgun_Gray</defName>
		<label>PDW Railgun</label>
		<ammoTypes>
			<Ammo_Railgun_Gray>Bullet_4mmRailgun_GR</Ammo_Railgun_Gray>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_AR_Railgun_Gray</defName>
		<label>Assault Rifle Railgun</label>
		<ammoTypes>
			<Ammo_Railgun_Gray>Bullet_6mmRailgun_GR</Ammo_Railgun_Gray>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_MG_Railgun_Gray</defName>
		<label>Machine Gun Railgun</label>
		<ammoTypes>
			<Ammo_Railgun_Gray>Bullet_8mmRailgun_GR</Ammo_Railgun_Gray>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
		<defName>Ammo_Railgun_Gray</defName>
		<label>Gray universal Railgun</label>
		<description>Fin-stabilized tungsten carbide penetrator with discarding sabot, designed for railgun.</description>
		<statBases>
			<Mass>0.01</Mass>
			<Bulk>0.01</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoGrayRailgun</li>
		</thingCategories>
		<graphicData>
			<texPath>Things/Ammo/Railgun/Rifle</texPath>
			<graphicClass>CombatExtended.Graphic_StackCountRanged</graphicClass>
		</graphicData>
		<ammoClass>RailgunSabot</ammoClass>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef ParentName="BaseBulletCE">
		<defName>Bullet_4mmRailgun_GR</defName>
		<label>4mm Railgun bullet (Sabot)</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>GR_NanoBullet</damageDef>
			<damageAmountBase>14</damageAmountBase>
			<armorPenetrationSharp>31.1</armorPenetrationSharp>
			<armorPenetrationBlunt>183.76</armorPenetrationBlunt>
			<speed>271</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseBulletCE">
		<defName>Bullet_6mmRailgun_GR</defName>
		<label>6mm Railgun bullet (Sabot)</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>GR_NanoBullet</damageDef>
			<damageAmountBase>19</damageAmountBase>
			<armorPenetrationSharp>56.1</armorPenetrationSharp>
			<armorPenetrationBlunt>290.80</armorPenetrationBlunt>
			<speed>300</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseBulletCE">
		<defName>Bullet_8mmRailgun_GR</defName>
		<label>8mm Railgun bullet (Sabot)</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>GR_NanoBullet</damageDef>
			<damageAmountBase>25</damageAmountBase>
			<armorPenetrationSharp>80.6</armorPenetrationSharp>
			<armorPenetrationBlunt>506.26</armorPenetrationBlunt>
			<speed>327</speed>
		</projectile>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_6mmRailgun_Sabot</defName>
		<label>make 6mm Railgun cartridge (Sabot) x500</label>
		<description>Craft 500 6mm Railgun (Sabot) cartridges.</description>
		<jobString>Making 6mm Railgun (Sabot) cartridges.</jobString>
		<workAmount>1000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Uranium</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Railgun_Gray>500</Ammo_Railgun_Gray>
		</products>
	</RecipeDef>

</Defs>