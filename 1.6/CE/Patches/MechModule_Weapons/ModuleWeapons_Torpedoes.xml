<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--太空鱼雷-->
  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>GR_MechWeapon_Torpedoes1_G</defName>
    <statBases>
      <SightsEfficiency>1</SightsEfficiency>
      <ShotSpread>0.01</ShotSpread>
      <SwayFactor>0</SwayFactor>
    </statBases>
    <Properties>
      <verbClass>CombatExtended.Verb_ShootCE</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Bullet_GR_Torpedoes1_G_CE</defaultProjectile>
      <warmupTime>5.25</warmupTime>
      <defaultCooldownTime>15.55</defaultCooldownTime>
      <range>29.9</range>
      <burstShotCount>1</burstShotCount>
      <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
      <soundCast>Shot_Slugthrower</soundCast>
      <soundCastTail>GunTail_Light</soundCastTail>
      <muzzleFlashScale>6</muzzleFlashScale>
    </Properties>
  </Operation>

