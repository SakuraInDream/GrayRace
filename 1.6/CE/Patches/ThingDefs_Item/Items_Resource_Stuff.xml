<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--灰潮源质-->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GR_Nanites"]/statBases/StuffPower_Armor_Blunt</xpath>
    <value>
      <StuffPower_Armor_Blunt>4</StuffPower_Armor_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Nanites"]/stuffProps/statFactors</xpath>
    <value>
      <MeleePenetrationFactor>1.2</MeleePenetrationFactor>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Nanites"]/stuffProps/categories</xpath>
    <value>
      <li>Metallic_Weapon</li>
      <li>Steeled</li>
    </value>
  </Operation>

  <!--合金-->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GR_Alloy"]/statBases/StuffPower_Armor_Sharp</xpath>
    <value>
      <StuffPower_Armor_Sharp>8</StuffPower_Armor_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GR_Alloy"]/statBases/StuffPower_Armor_Blunt</xpath>
    <value>
      <StuffPower_Armor_Blunt>32</StuffPower_Armor_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GR_Alloy"]/statBases/StuffPower_Armor_Heat</xpath>
    <value>
      <StuffPower_Armor_Heat>0.3</StuffPower_Armor_Heat>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Alloy"]/statBases</xpath>
    <value>
      <StuffPower_Armor_Electric>0.3</StuffPower_Armor_Electric>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Alloy"]/stuffProps/statFactors</xpath>
    <value>
      <MeleePenetrationFactor>2</MeleePenetrationFactor>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Alloy"]/stuffProps/categories</xpath>
    <value>
      <li>Metallic_Weapon</li>
      <li>Steeled</li>
    </value>
  </Operation>

  <!--泽珞-->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Zro"]/stuffProps/statFactors</xpath>
    <value>
      <MeleePenetrationFactor>1.3</MeleePenetrationFactor>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Zro"]/stuffProps/categories</xpath>
    <value>
      <li>Metallic_Weapon</li>
      <li>Steeled</li>
      <li>SoftArmor</li>
    </value>
  </Operation>

</Patch>
