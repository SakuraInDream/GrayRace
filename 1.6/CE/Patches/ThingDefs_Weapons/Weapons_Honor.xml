<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ================ Melee ================ -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[ defName="GR_Daikyu" or defName="GR_Vadarya" or defName="GR_Boltor" or defName="GR_Corinth" or defName="GR_Euphona" or defName="GR_Vasto"
        ]/tools</xpath>
    <value>
      <tools>
        <li Class="CombatExtended.ToolCE">
          <label>stock</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>10</power>
          <cooldownTime>1.3</cooldownTime>
          <chanceFactor>1.5</chanceFactor>
          <armorPenetrationBlunt>3</armorPenetrationBlunt>
          <linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
        </li>
        <li Class="CombatExtended.ToolCE">
          <label>barrel</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>6</power>
          <cooldownTime>1.8</cooldownTime>
          <armorPenetrationBlunt>2</armorPenetrationBlunt>
          <linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
        </li>
        <li Class="CombatExtended.ToolCE">
          <label>muzzle</label>
          <capacities>
            <li>Poke</li>
          </capacities>
          <power>10</power>
          <cooldownTime>1.3</cooldownTime>
          <armorPenetrationBlunt>3</armorPenetrationBlunt>
          <linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>

  <!-- ================ Weapon ================ -->

  <!--大久和弓-->

  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>GR_Daikyu</defName>
    <statBases>
      <SightsEfficiency>1.5</SightsEfficiency>
      <ShotSpread>0.2</ShotSpread>
      <SwayFactor>2.1</SwayFactor>
      <Bulk>15</Bulk>
      <Mass>6</Mass>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <Properties>
      <recoilAmount>0</recoilAmount>
      <verbClass>CombatExtended.Verb_ShootCE</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Bullet_Daikyu_GR</defaultProjectile>
      <warmupTime>2</warmupTime>
      <ticksBetweenBurstShots>60</ticksBetweenBurstShots>
      <range>70</range>
      <soundCast>Bow_Large</soundCast>
      <soundCastTail>GunTail_Heavy</soundCastTail>
      <muzzleFlashScale>9</muzzleFlashScale>
    </Properties>
    <AmmoUser>
      <ammoSet>AmmoSet_Daikyu</ammoSet>
    </AmmoUser>
    <FireModes />
  </Operation>

  <!--科林斯-->

  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>GR_Corinth</defName>
    <statBases>
      <SightsEfficiency>1</SightsEfficiency>
      <ShotSpread>0.07</ShotSpread>
      <SwayFactor>1.21</SwayFactor>
      <Bulk>7</Bulk>
      <Mass>4</Mass>
      <RangedWeapon_Cooldown>0.8</RangedWeapon_Cooldown>
    </statBases>
    <Properties>
      <recoilAmount>2.5</recoilAmount>
      <verbClass>CombatExtended.Verb_ShootCE</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Bullet_23x75mmR_Buck</defaultProjectile>
      <warmupTime>0.6</warmupTime>
      <range>15</range>
      <soundCast>Shot_Shotgun</soundCast>
      <soundCastTail>GunTail_Heavy</soundCastTail>
      <muzzleFlashScale>9</muzzleFlashScale>
    </Properties>
    <AmmoUser>
      <magazineSize>20</magazineSize>
      <reloadOneAtATime>true</reloadOneAtATime>
      <reloadTime>0.25</reloadTime>
      <ammoSet>AmmoSet_23x75mmR</ammoSet>
    </AmmoUser>
    <FireModes>
      <aiAimMode>Snapshot</aiAimMode>
    </FireModes>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="GR_CorinthBomb"]/verbProperties/range</xpath>
    <value>
      <range>90</range>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GR_Corinth"]/comps/li[@Class="CompProperties_EquippableAbilityReloadable"]</xpath>
    <value>
      <li Class="CompProperties_EquippableAbilityReloadable">
        <abilityDef>GR_CorinthBomb</abilityDef>
        <maxCharges>5</maxCharges>
        <soundReload>Standard_Reload</soundReload>
        <chargeNoun>charge</chargeNoun>
        <ammoDef>Ammo_23x75mmR_Buck</ammoDef>
        <ammoCountPerCharge>4</ammoCountPerCharge>
        <baseReloadTicks>60</baseReloadTicks>
      </li>
    </value>
  </Operation>

  <!--螺钉步枪-->

  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>GR_Boltor</defName>
    <statBases>
      <SightsEfficiency>1</SightsEfficiency>
      <ShotSpread>0.07</ShotSpread>
      <SwayFactor>1.1</SwayFactor>
      <Bulk>8</Bulk>
      <Mass>4.5</Mass>
      <RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
    </statBases>
    <Properties>
      <recoilAmount>1.8</recoilAmount>
      <verbClass>CombatExtended.Verb_ShootCE</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Bullet_50BMG_FMJ</defaultProjectile>
      <warmupTime>1</warmupTime>
      <burstShotCount>5</burstShotCount>
      <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
      <range>55</range>
      <soundCast>Shot_AssaultRifle</soundCast>
      <soundCastTail>GunTail_Heavy</soundCastTail>
      <muzzleFlashScale>9</muzzleFlashScale>
    </Properties>
    <AmmoUser>
      <magazineSize>60</magazineSize>
      <reloadTime>3.5</reloadTime>
      <ammoSet>AmmoSet_50BMG</ammoSet>
    </AmmoUser>
    <FireModes>
      <aimedBurstShotCount>3</aimedBurstShotCount>
      <aiUseBurstMode>TRUE</aiUseBurstMode>
      <aiAimMode>Snapshot</aiAimMode>
    </FireModes>
  </Operation>

  <!--瓦德雅-->

