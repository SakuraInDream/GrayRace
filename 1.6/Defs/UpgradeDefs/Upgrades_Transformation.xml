<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 手部变形升级 -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Transform_Hand_PowerClaw</defName>
    <label>动力爪形态</label>
    <description>将手部纳米机械重组为高硬度动力爪，大幅提升近战伤害。</description>
    <upgradeType>Transformation</upgradeType>
    <coexistWithUpgradeTypes>
      <li>Plugin</li>
    </coexistWithUpgradeTypes>
    <targetBodyPartGroups>
      <li>Hands</li>
    </targetBodyPartGroups>
    <excludedBodyPartTags>
      <li>ManipulationLimbDigit</li>
    </excludedBodyPartTags>
    <hediffToApply>GR_Hediff_PowerClaw</hediffToApply>
    <researchPrerequisite>AdvancedFabrication</researchPrerequisite>
    <uiOrder>10</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Transform_Hand_ToolArm</defName>
