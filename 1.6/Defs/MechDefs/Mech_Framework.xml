<Defs>

  <SD.GrayRace.Defs.GRMechSlotTypeDef>
    <defName>GR_MechSlot_Weapon</defName>
    <label>weapon slot</label>
    <description>Weapon hardpoint that follows Stellaris-style size rules.</description>
  </SD.GrayRace.Defs.GRMechSlotTypeDef>

  <SD.GrayRace.Defs.GRMechSlotTypeDef>
    <defName>GR_MechSlot_Utility</defName>
    <label>utility slot</label>
    <description>Utility slot for size-based defensive and support components.</description>
  </SD.GrayRace.Defs.GRMechSlotTypeDef>

  <SD.GrayRace.Defs.GRMechSlotTypeDef>
    <defName>GR_MechSlot_Aux</defName>
    <label>aux slot</label>
    <description>Auxiliary slot that does not use S/M/L/X/T sizes, matching Stellaris A-slot behavior.</description>
    <ignoreSize>true</ignoreSize>
  </SD.GrayRace.Defs.GRMechSlotTypeDef>

  <SD.GrayRace.Defs.GRMechSlotSizeDef>
