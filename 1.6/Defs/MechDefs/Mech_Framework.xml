  </SD.GrayRace.Defs.GRMechComponentSlotTemplateDef>

  <SD.GrayRace.Defs.GRMechSectionRoleDef>
    <defName>GR_MechSection_Bow</defName>
    <label>bow section</label>
    <description>Forward combat section.</description>
  </SD.GrayRace.Defs.GRMechSectionRoleDef>

  <SD.GrayRace.Defs.GRMechSectionRoleDef>
    <defName>GR_MechSection_Core</defName>
    <label>core section</label>
    <description>Central systems section.</description>
  </SD.GrayRace.Defs.GRMechSectionRoleDef>

  <SD.GrayRace.Defs.GRMechSectionRoleDef>
    <defName>GR_MechSection_Stern</defName>
    <label>stern section</label>
    <description>Rear propulsion section.</description>
  </SD.GrayRace.Defs.GRMechSectionRoleDef>

  <SD.GrayRace.Defs.GRMechSectionLayoutDef>
    <defName>GR_FF_Bow_Interceptor</defName>
    <label>interceptor bow</label>
    <description>Light forward combat section for compact ship-killer batteries.</description>
    <sectionRole>GR_MechSection_Bow</sectionRole>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <additionalCostList>
      <GR_Alloy>10</GR_Alloy>
    </additionalCostList>
    <componentSlots>
      <li>
        <key>ff_main_gun</key>
        <label>bow gun mount</label>
        <template>GR_MechComponentSlot_SmallTurret</template>
        <anchorBodyPart>MechanicalHand</anchorBodyPart>
      </li>
    </componentSlots>
  </SD.GrayRace.Defs.GRMechSectionLayoutDef>

  <SD.GrayRace.Defs.GRMechSectionLayoutDef>
    <defName>GR_FF_Bow_Assault</defName>
    <label>assault bow</label>
    <description>Forward combat section with a primary gun mount and a dedicated precision uplink hardpoint.</description>
    <sectionRole>GR_MechSection_Bow</sectionRole>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <additionalCostList>
      <GR_Alloy>20</GR_Alloy>
      <GR_Nanites>10</GR_Nanites>
    </additionalCostList>
    <componentSlots>
      <li>
        <key>ff_main_gun</key>
        <label>forward gun mount</label>
        <template>GR_MechComponentSlot_SmallTurret</template>
        <anchorBodyPart>MechanicalHand</anchorBodyPart>
        <uiOrder>10</uiOrder>
      </li>
    </componentSlots>
    <auxUtilitySlots>1</auxUtilitySlots>
  </SD.GrayRace.Defs.GRMechSectionLayoutDef>

  <SD.GrayRace.Defs.GRMechSectionLayoutDef>
    <defName>GR_FF_Core_Scout</defName>
    <label>scout core</label>
    <description>Compact command and sensor package optimized for fast reconnaissance.</description>
    <sectionRole>GR_MechSection_Core</sectionRole>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <smallUtilitySlots>1</smallUtilitySlots>
  </SD.GrayRace.Defs.GRMechSectionLayoutDef>

  <SD.GrayRace.Defs.GRMechSectionLayoutDef>
    <defName>GR_FF_Core_Command</defName>
    <label>command core</label>
    <description>Expanded command section with dedicated combat analysis and communications hardpoints.</description>
    <sectionRole>GR_MechSection_Core</sectionRole>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <additionalCostList>
      <GR_Alloy>15</GR_Alloy>
      <GR_Nanites>20</GR_Nanites>
    </additionalCostList>
    <smallUtilitySlots>1</smallUtilitySlots>
    <auxUtilitySlots>2</auxUtilitySlots>
  </SD.GrayRace.Defs.GRMechSectionLayoutDef>

  <SD.GrayRace.Defs.GRMechSectionLayoutDef>
    <defName>GR_FF_Stern_Vector</defName>
    <label>vector stern</label>
    <description>Rear propulsion frame built around a single high-response thruster bank.</description>
    <sectionRole>GR_MechSection_Stern</sectionRole>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <auxUtilitySlots>1</auxUtilitySlots>
  </SD.GrayRace.Defs.GRMechSectionLayoutDef>

  <SD.GrayRace.Defs.GRMechSectionLayoutDef>
    <defName>GR_FF_Stern_Endurance</defName>
    <label>endurance stern</label>
    <description>Rear propulsion section that trades burst agility for reactor management and sustained output.</description>
    <sectionRole>GR_MechSection_Stern</sectionRole>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <additionalCostList>
      <GR_Alloy>15</GR_Alloy>
      <GR_Nanites>10</GR_Nanites>
    </additionalCostList>
    <smallUtilitySlots>1</smallUtilitySlots>
    <auxUtilitySlots>1</auxUtilitySlots>
  </SD.GrayRace.Defs.GRMechSectionLayoutDef>

  <SD.GrayRace.Defs.GRMechChassisDef>
    <defName>GR_Chassis_FF</defName>
    <label>frigate frame</label>
    <description>Baseline light warship chassis used by Gray autonomous combat craft.</description>
    <pawnKindDef>GR_Mech_FF</pawnKindDef>
    <designerPreviewPath>Race/Mech/FF_south</designerPreviewPath>
    <fixedWorkTicks>60000</fixedWorkTicks>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <baseCostList>
      <GR_Alloy>60</GR_Alloy>
      <SubcoreBasic>1</SubcoreBasic>
    </baseCostList>
    <sections>
      <li>
        <role>GR_MechSection_Bow</role>
        <layouts>
          <li>GR_FF_Bow_Interceptor</li>
          <li>GR_FF_Bow_Assault</li>
        </layouts>
        <defaultLayout>GR_FF_Bow_Interceptor</defaultLayout>
      </li>
      <li>
        <role>GR_MechSection_Core</role>
        <layouts>
          <li>GR_FF_Core_Scout</li>
          <li>GR_FF_Core_Command</li>
        </layouts>
        <defaultLayout>GR_FF_Core_Scout</defaultLayout>
      </li>
      <li>
        <role>GR_MechSection_Stern</role>
        <layouts>
          <li>GR_FF_Stern_Vector</li>
          <li>GR_FF_Stern_Endurance</li>
        </layouts>
        <defaultLayout>GR_FF_Stern_Vector</defaultLayout>
      </li>
    </sections>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechModuleDef>
    <defName>GR_MechModule_FF_AA12mm</defName>
    <label>12mm AA battery</label>
    <description>Compact rapid-fire gun battery intended for light Gray frigate hulls.</description>
    <allowedChassis>
      <li>GR_Chassis_FF</li>
    </allowedChassis>
    <allowedSlotTypes>
      <li>GR_MechSlot_Weapon</li>
    </allowedSlotTypes>
    <allowedSlotSizes>
      <li>GR_MechSlotSize_S</li>
    </allowedSlotSizes>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>20</GR_Alloy>
    </costList>
    <equipmentDef>GR_MechWeapon_12mmAA</equipmentDef>
  </SD.GrayRace.Defs.GRMechModuleDef>

  <SD.GrayRace.Defs.GRMechModuleDef>
    <defName>GR_MechModule_FF_ScoutSuite</defName>
    <label>scout electronics suite</label>
    <description>Integrated reconnaissance array and command electronics package.</description>
    <allowedChassis>
      <li>GR_Chassis_FF</li>
    </allowedChassis>
    <allowedSlotTypes>
      <li>GR_MechSlot_Utility</li>
    </allowedSlotTypes>
    <allowedSlotSizes>
      <li>GR_MechSlotSize_S</li>
    </allowedSlotSizes>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Nanites>20</GR_Nanites>
    </costList>
    <hediffToApply>GR_Hediff_AnalysisChip</hediffToApply>
    <anchorBodyPart>HearingSensor</anchorBodyPart>
  </SD.GrayRace.Defs.GRMechModuleDef>

  <SD.GrayRace.Defs.GRMechModuleDef>
    <defName>GR_MechModule_FF_VectorThruster</defName>
