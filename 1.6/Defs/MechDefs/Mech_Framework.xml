  <SD.GrayRace.Defs.GRMechPresetDef>
    <defName>GR_MechPreset_FF_Interceptor</defName>
    <label>interceptor package</label>
    <description>Default Gray frigate fit tuned for screening and light ship interception.</description>
    <chassis>GR_Chassis_FF</chassis>
    <sections>
      <li>
        <role>GR_MechSection_Bow</role>
        <layout>GR_FF_Bow_Interceptor</layout>
      </li>
      <li>
        <role>GR_MechSection_Core</role>
        <layout>GR_FF_Core_Scout</layout>
      </li>
      <li>
        <role>GR_MechSection_Stern</role>
        <layout>GR_FF_Stern_Vector</layout>
      </li>
    </sections>
    <modules>
      <li>
        <slotKey>ff_main_gun</slotKey>
        <module>GR_MechModule_FF_AA12mm</module>
      </li>
      <li>
        <slotKey>GR_FF_Core_Scout_SMALL_UTILITY_GR_MechSlotSize_S_1</slotKey>
        <module>GR_MechModule_FF_ScoutSuite</module>
      </li>
      <li>
        <slotKey>GR_FF_Stern_Vector_AUX_UTILITY_1</slotKey>
        <module>GR_MechModule_FF_VectorThruster</module>
      </li>
    </modules>
  </SD.GrayRace.Defs.GRMechPresetDef>

