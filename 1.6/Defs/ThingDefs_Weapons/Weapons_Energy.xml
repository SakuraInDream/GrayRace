  <!--能量冲（流光）-->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>GR_EnergyPDW</defName>
    <label>Flowglow</label>
    <description>Gray Standard-issue Energy PDW.Its compact frame is almost entirely dedicated to the particle accelerator, enabling true instant-fire capability. However, its low stopping power makes it effective only against humans and smaller foes, rendering it unpopular among Grays who frequently encounter bizarre alien lifeforms.</description>
    <graphicData>
      <texPath>Things/Item/Weapon/Energy/Energy_PDW</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <equippedAngleOffset>45</equippedAngleOffset>
