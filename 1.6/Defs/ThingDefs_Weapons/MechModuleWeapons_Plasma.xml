<Defs>

  <!-- ================ 等离子发射器 ================ -->
  <ThingDef ParentName="LightMechanoidGunRanged">
    <defName>GR_MechWeapon_Plasma1_S</defName>
    <label>Small Plasma Thrower</label>
    <description>A weapon that fires devastating high-energy plasma spheres. These plasma projectiles are especially effective against the armor of large ships.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Weapon/MechFloating/Floating_MassDriver_S</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.3</AccuracyTouch>
      <AccuracyShort>0.7</AccuracyShort>
      <AccuracyMedium>0.8</AccuracyMedium>
      <AccuracyLong>0.4</AccuracyLong>
    </statBases>
    <weaponTags/>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_GR_MechPlasma1_S</defaultProjectile>
        <warmupTime>1.25</warmupTime>
        <defaultCooldownTime>3.75</defaultCooldownTime>
        <range>19.9</range>
        <soundCast>Shot_Slugthrower</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_GR_MechPlasma1_S</defName>
