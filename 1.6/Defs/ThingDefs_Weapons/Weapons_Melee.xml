    <costList>
      <GR_Alloy>240</GR_Alloy>
      <GR_Nanites>100</GR_Nanites>
    </costList>
    <equippedAngleOffset>-90</equippedAngleOffset>
    <tools>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>40</power>
