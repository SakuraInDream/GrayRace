            <amount>10</amount>
          </li>
        </extraMeleeDamages>
        <armorPenetration>2</armorPenetration>
        <cooldownTime>0.3</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>GR_T3WeaponTech</researchPrerequisite>
      <skillRequirements>
        <Crafting>16</Crafting>
      </skillRequirements>
      <displayPriority>410</displayPriority>
    </recipeMaker>
  </ThingDef>

