<Defs>
  <ThingDef ParentName="LightMechanoidGunRanged">
    <defName>GR_MechWeapon_PDArray</defName>
    <label>Point Defense</label>
    <description>A rapid interception array used to swat down incoming threats and screen light hulls.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/MiniShotgun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>900</MarketValue>
      <Mass>1.2</Mass>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>0.82</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags/>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_PDArray</defaultProjectile>
        <warmupTime>0.3</warmupTime>
        <range>29.9</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <soundCast>Shot_Shotgun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>4</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

