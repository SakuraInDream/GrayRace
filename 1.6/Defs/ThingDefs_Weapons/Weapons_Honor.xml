  <!--大久和弓-->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>GR_Daikyu</defName>
    <label>Daikyu</label>
    <description>Born in an era before the Gray race, this heavy weapon was retrofitted by a group of heavy-firepower enthusiasts from a decommissioned frigate secondary turret. Its staggering recoil made it nearly unmanageable even for enhanced soldiers in exosuits, leading to its eventual adoption by the Grays to counter megafauna during colonial expansion. Firing massively armored high-explosive rounds via an extended high-pressure rail and heavy-duty capacitor, its destructive power is sufficient to level a small structure or turn a 22nd-century main battle tank into scrap metal.</description>
    <graphicData>
      <texPath>Things/Item/Weapon/Honor/Honor_Daikyu</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <equippedAngleOffset>45</equippedAngleOffset>
    <soundInteract>Interact_Rifle</soundInteract>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <thingCategories>
      <li>GR_WeaponsRanged</li>
    </thingCategories>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <statBases>
      <WorkToMake>34000</WorkToMake>
      <Mass>6</Mass>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.9</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
      <RangedWeapon_Cooldown>2.3</RangedWeapon_Cooldown>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <GR_Alloy>40</GR_Alloy>
      <GR_Nanites>40</GR_Nanites>
      <Gold>10</Gold>
    </costList>
    <recipeMaker Inherit="False">
