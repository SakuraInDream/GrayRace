<Defs>

  <!--磁轨冲（脉冲）-->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>GR_RailPDW</defName>
    <label>Gray Railgun PDW</label>
    <description>Gray standard rail SMG, also known as Satellite. Its low-pressure rail and small capacitor provide only modest muzzle velocity and EMP coating, but in return it offers an extremely high rate of fire, stability, and an almost inaudible report. Its ultra-lightweight design allows for extremely fast draw speed; it is the best partner for infiltration missions and the preferred close-defense weapon of most Gray.</description>
    <graphicData>
      <texPath>Things/Item/Weapon/RailGun/Rail_PDW</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <equippedAngleOffset>45</equippedAngleOffset>
    <soundInteract>Interact_SMG</soundInteract>
    <weaponClasses>
      <li>ShortShots</li>
      <li>RangedHeavy</li>
    </weaponClasses>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>GR_NaniteReconfigurator</li>
      </recipeUsers>
      <researchPrerequisites>
        <li>GR_Railgun</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <thingCategories>
      <li>GR_WeaponsRanged</li>
    </thingCategories>
    <techLevel>Spacer</techLevel>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <Mass>2</Mass>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>0.95</AccuracyShort>
      <AccuracyMedium>0.6</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
      <RangedWeapon_Cooldown>1.3</RangedWeapon_Cooldown>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <GR_Alloy>60</GR_Alloy>
      <GR_Nanites>30</GR_Nanites>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_GR_RailSMG</defaultProjectile>
        <warmupTime>0.7</warmupTime>
        <range>23.9</range>
        <burstShotCount>7</burstShotCount>
        <ticksBetweenBurstShots>3</ticksBetweenBurstShots>
        <soundCast>GR_RailPDWShoot</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
      <li>GR_BasicWeapon</li>
    </weaponTags>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
