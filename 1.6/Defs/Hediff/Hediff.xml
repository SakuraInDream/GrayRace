<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--灰潮再生-->
  <HediffDef>
    <defName>NanitesRegeneration</defName>
    <label>灰潮再生</label>
    <hediffClass>HediffWithComps</hediffClass>
    <!-- <hediffClass>Hediff_RapidRegeneration</hediffClass> -->
    <description>运用体内的备用灰潮源质能够快速修复身上的伤口。</description>
    <isBad>false</isBad>
    <preventsDeath>false</preventsDeath>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <stages>
      <li>
        <totalBleedFactor>0</totalBleedFactor>
        <minSeverity>0</minSeverity>
        <!-- <statOffsets>
          <GRStat_NaniteRegenRate>-0.02</GRStat_NaniteRegenRate>
        </statOffsets> -->
        <!-- <regeneration>5000</regeneration> -->
        <!-- <painFactor>0</painFactor> -->
      </li>
    </stages>
    <comps>
      <!-- <li Class="SD.GrayRace.Hediffs.HediffCompProperties_NanitesRegeneration" /> -->
      <li Class="SD.GrayRace.Hediffs.HediffCompProperties_NanitesRegeneration">
        <naniteCostPerSeconds>0.01</naniteCostPerSeconds>
        <healAmountPerSeconds>1</healAmountPerSeconds>
      </li>
    </comps>
  </HediffDef>

  <!--灰潮生命-->
  <HediffDef>
    <defName>NanitesLife</defName>
    <label>灰潮生命</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>你不应该看到这个。</description>
    <isBad>false</isBad>
    <preventsDeath>false</preventsDeath>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <makeImmuneTo>
          <li>Flu</li>
          <li>GutWorms</li>
          <li>FibrousMechanites</li>
          <li>Malaria</li>
          <li>MuscleParasites</li>
          <li>Plague</li>
          <li>SensoryMechanites</li>
          <li>SleepingSickness</li>
          <li>WoundInfection</li>
        </makeImmuneTo>
        <naturalHealingFactor>0</naturalHealingFactor>
        <minSeverity>0</minSeverity>
        <disablesNeeds>
          <li>Food</li>
        </disablesNeeds>
      </li>
    </stages>
  </HediffDef>
</Defs>
