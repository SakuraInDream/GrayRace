      <solid>true</solid>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <statOffsets>
          <PlantWorkSpeed>1.60</PlantWorkSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

