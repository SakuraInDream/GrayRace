<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 变形Hediff -->

  <!-- 夜视 CE 用的 -->
  <HediffDef MayRequire="CETeam.CombatExtended">
    <defName>GR_Hediff_NightVisionEye</defName>
    <label>夜视眼</label>
    <hediffClass>Hediff_AddedPart</hediffClass>
    <description>眼部变形为夜视系统。</description>
    <defaultLabelColor>(0.3, 0.8, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1.1</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <statOffsets>
          <!-- <NightVisionEfficiency MayRequire="CETeam.CombatExtended">2.0</NightVisionEfficiency> -->
          <NightVisionEfficiency>2.0</NightVisionEfficiency>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 插件 Hediff 示例 -->

  <!-- 战斗芯片 -->
  <HediffDef>
    <defName>GR_Hediff_CombatChip</defName>
    <label>战斗芯片</label>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <description>植入大脑的战斗芯片，提升战斗能力。</description>
    <defaultLabelColor>(0.8, 0.3, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>0.25</ShootingAccuracyPawn>
          <MeleeHitChance>0.2</MeleeHitChance>
          <MeleeDodgeChance>0.15</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 分析芯片 -->
  <HediffDef>
    <defName>GR_Hediff_AnalysisChip</defName>
    <label>分析芯片</label>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <description>植入大脑的分析芯片，提升学习能力。</description>
    <defaultLabelColor>(0.3, 0.3, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <ResearchSpeed>0.5</ResearchSpeed>
          <GlobalLearningFactor>0.3</GlobalLearningFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 效率增强器 -->
  <HediffDef>
    <defName>GR_Hediff_EfficiencyBooster</defName>
    <label>效率增强器</label>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <description>安装在灰潮核心的增强器。增加备用灰潮机械回复速度</description>
    <defaultLabelColor>(0.2, 0.8, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <GRStat_NaniteRegenRate>1</GRStat_NaniteRegenRate>
          <GRStat_OverclockMaxLevel>0.5</GRStat_OverclockMaxLevel>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 精密芯片 -->
  <HediffDef>
    <defName>GR_Hediff_PrecisionChip</defName>
    <label>精密芯片</label>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <description>植入手部的精密操作芯片。</description>
    <defaultLabelColor>(0.6, 0.3, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>0.2</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 瞄准系统 -->
  <HediffDef>
    <defName>GR_Hediff_TargetingSystem</defName>
    <label>瞄准系统</label>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <description>植入眼部的先进瞄准系统。</description>
    <defaultLabelColor>(0.8, 0.6, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>0.35</ShootingAccuracyPawn>
          <AimingDelayFactor>-0.2</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>GR_Hediff_OverclockingChipPrimary</defName>
    <label>初级超频芯片</label>
    <description>增加25%超频上限。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <GRStat_OverclockMaxLevel>0.25</GRStat_OverclockMaxLevel>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>GR_Hediff_OverclockingChipIntermediate</defName>
    <label>中级超频芯片</label>
    <description>增加75%超频上限。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <GRStat_OverclockMaxLevel>0.75</GRStat_OverclockMaxLevel>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>GR_Hediff_OverclockingChipAdvanced</defName>
    <label>高级超频芯片</label>
    <description>增加150%超频上限。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <GRStat_OverclockMaxLevel>1.5</GRStat_OverclockMaxLevel>
          <GRStat_NaniteMax>-750</GRStat_NaniteMax>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>GR_Hediff_OverclockingChipUltimate</defName>
    <label>终级超频芯片</label>
    <description>增加250%超频上限。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <GRStat_OverclockMaxLevel>2.5</GRStat_OverclockMaxLevel>
          <GRStat_NaniteMax>-750</GRStat_NaniteMax>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
