<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--灰潮再生-->
  <HediffDef>
    <defName>NanitesRegeneration</defName>
    <label>Gray Tide Regeneration</label>
    <hediffClass>HediffWithComps</hediffClass>
    <!-- <hediffClass>Hediff_RapidRegeneration</hediffClass> -->
    <description>Uses the spare Nanite in the body to rapidly repair wounds.</description>
    <isBad>false</isBad>
    <preventsDeath>false</preventsDeath>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
    <comps>
      <li Class="SD.GrayRace.Hediffs.HediffCompProperties_NanitesRegeneration">
        <naniteCostPerSeconds>10</naniteCostPerSeconds>
        <healAmountPerSeconds>5</healAmountPerSeconds>
      </li>
    </comps>
  </HediffDef>

  <!--灰潮生命-->
  <HediffDef>
    <defName>NanitesLife</defName>
    <label>Gray Tide Life</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>You should not be seeing this.</description>
    <isBad>false</isBad>
    <preventsDeath>false</preventsDeath>
    <stages>
      <li>
        <capMods>
          <li MayRequire="rim.job.world">
            <capacity>RJW_Fertility</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
        <statFactors>
          <PsychicSensitivity>0</PsychicSensitivity>
          <Fertility>0</Fertility>
        </statFactors>
        <becomeVisible>false</becomeVisible>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>
</Defs>
