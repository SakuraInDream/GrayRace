<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Line computers -->
  <HediffDef>
    <defName>GR_Hediff_CombatComputer_Line_Basic</defName>
    <label>basic line combat computer</label>
    <hediffClass>HediffWithComps</hediffClass>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <description>Line combat computer. RimWorld equivalent: 5% faster ranged cooldowns and +5 shooting accuracy.</description>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <RangedCooldownFactor>-0.05</RangedCooldownFactor>
          <ShootingAccuracyPawn>5</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

