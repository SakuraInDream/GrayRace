<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 下列插件均为临时示例用，随时会删 -->
  <!-- 大脑插件示例 -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_CombatChip</defName>
    <label>战斗芯片</label>
    <description>植入人格核心的高级战斗芯片，提升战斗效率和反应速度。</description>
    <!-- 图标路径 贴图大小 64x64 以上，至少 45x45 -->
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Brain</targetBodyPart>     <!-- 施加的身体部位 -->
    <hediffToApply>GR_Hediff_CombatChip</hediffToApply>     <!-- 对应的的 Hediff-->
    <exclusionTags>     <!-- 排除标签 -->
      <li>WorkChip</li>
    </exclusionTags>
    <researchPrerequisites>     <!-- 科技前置 -->
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <requiredMaterials>         <!-- 需要材料 -->
      <ComponentIndustrial>5</ComponentIndustrial>
      <Plasteel>20</Plasteel>
    </requiredMaterials>
    <workAmount>2000</workAmount>
    <requiredSkill>Crafting</requiredSkill>       <!-- 需要技能 -->
    <minSkillLevel>8</minSkillLevel>        <!-- 需要技能等级 -->
    <uiOrder>10</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_AnalysisChip</defName>
    <label>分析芯片</label>
    <description>植入人格核心的超级分析芯片，提升研究速度和学习能力。</description>
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_AnalysisChip</hediffToApply>
    <exclusionTags>
      <li>WorkChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <requiredMaterials>
      <ComponentIndustrial>8</ComponentIndustrial>
      <Gold>10</Gold>
    </requiredMaterials>
    <workAmount>2500</workAmount>
    <requiredSkill>Intellectual</requiredSkill>
    <minSkillLevel>10</minSkillLevel>
    <uiOrder>20</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_Mechlink</defName>
    <label>机控中枢</label>
    <description>将机控中枢与人格核心连接，允许操控机械族。</description>
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>MechlinkImplant</hediffToApply>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <requiredMaterials>
      <Mechlink>1</Mechlink>
    </requiredMaterials>
    <workAmount>60</workAmount>
    <requiredSkill>Intellectual</requiredSkill>
    <minSkillLevel>8</minSkillLevel>
    <uiOrder>0</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

