<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ================================== 大脑插件 ================================== -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_CombatChip</defName>
    <label>CombatChip</label>
    <description>An advanced combat chip implanted in the persona core that improves ranged shooting ability.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Brain</targetBodyPart>    <!-- 目标身体部位 -->
    <hediffToApply>GR_Hediff_CombatChip</hediffToApply>    <!-- 对应的Hediff-->
    <exclusionTags>      <!-- 排除标签 -->
      <li>PrimaryChip</li>
    </exclusionTags>
    <researchPrerequisites>      <!-- 科技前置 -->
      <li>GR_T2Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>      <!-- 需要材料 -->
      <GR_Nanites>100</GR_Nanites>
      <ComponentSpacer>4</ComponentSpacer>
      <Gold>50</Gold>
    </requiredMaterials>
    <workAmount>2500</workAmount>
    <requiredSkill>Shooting</requiredSkill>    <!-- 需要技能 -->
    <minSkillLevel>4</minSkillLevel>    <!-- 需要技能等级 -->
    <uiOrder>10</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_ReactionChip</defName>
    <label>Reaction Chip</label>
    <description>A refined data chip storing countless combat techniques. Respond, predict, execute—when close combat begins, it will prove its worth.</description>
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_ReactionChip</hediffToApply>
    <exclusionTags>
      <li>PrimaryChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T2Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>100</GR_Nanites>
      <ComponentSpacer>4</ComponentSpacer>
      <Gold>50</Gold>
    </requiredMaterials>
    <workAmount>2500</workAmount>
    <requiredSkill>Melee</requiredSkill>
    <minSkillLevel>4</minSkillLevel>
    <uiOrder>20</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_AnalysisChip</defName>
    <label>Analysis Chip</label>
    <description>An expansion chip that assists the primary persona core in learning. It iterates data many times to predict the consequences of different choices. ...With enough failures, it should eventually deduce the correct path.</description>
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_AnalysisChip</hediffToApply>
    <exclusionTags>
      <li>PrimaryChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T2Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>100</GR_Nanites>
      <ComponentSpacer>4</ComponentSpacer>
      <Gold>50</Gold>
    </requiredMaterials>
    <workAmount>2500</workAmount>
    <requiredSkill>Intellectual</requiredSkill>
    <minSkillLevel>4</minSkillLevel>
    <uiOrder>30</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_ConcentrateChip</defName>
    <label>Concentrate Chip</label>
    <description>A concentration chip implanted in the persona core that improves work ability.</description>
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_ConcentrateChip</hediffToApply>
    <exclusionTags>
      <li>PrimaryChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T2Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>100</GR_Nanites>
      <ComponentSpacer>4</ComponentSpacer>
      <Gold>50</Gold>
    </requiredMaterials>
    <workAmount>2500</workAmount>
    <requiredSkill>Crafting</requiredSkill>
    <minSkillLevel>4</minSkillLevel>
    <uiOrder>40</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <!-- 技工本地数据库 -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_TechnicianDatabase</defName>
    <label>Technician local database</label>
    <description>A database containing vast numbers of blueprints. It even records the specifications of screws that exist—and no longer exist—throughout the universe, along with the corresponding tools.</description>
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_TechnicianDatabase</hediffToApply>
    <exclusionTags>
      <li>SecondaryChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T3Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>100</GR_Nanites>
      <ComponentSpacer>10</ComponentSpacer>
    </requiredMaterials>
    <workAmount>2500</workAmount>
    <requiredSkill>Intellectual</requiredSkill>
    <minSkillLevel>10</minSkillLevel>
    <uiOrder>20</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <!-- 机控中枢 -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Brain_Mechlink</defName>
    <label>Mechlink</label>
    <description>Connects the mechlink to the persona core, allowing the control of mechanoids.</description>
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>MechlinkImplant</hediffToApply>
    <requiredMaterials>
      <Mechlink>1</Mechlink>
    </requiredMaterials>
    <workAmount>60</workAmount>
    <requiredSkill>Intellectual</requiredSkill>
    <minSkillLevel>4</minSkillLevel>
    <uiOrder>0</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <!-- 超频芯片 -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_OverclockingChipPrimary</defName>
    <label>Primary overclocking chip</label>
    <description>A simple overclocking support plugin. It merely controls the redistribution and optimization of core energy.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_OverclockingChipPrimary</hediffToApply>
    <exclusionTags>
      <li>OverclockChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T1Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>50</GR_Nanites>
      <ComponentSpacer>1</ComponentSpacer>
    </requiredMaterials>
    <workAmount>120</workAmount>
    <uiOrder>100</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_OverclockingChipIntermediate</defName>
    <label>Intermediate overclocking chip</label>
    <description>A carefully engineered overclocking support plugin. It reaches the limit of what is possible under safe overclocking. For many Gray, it is a watershed.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_OverclockingChipIntermediate</hediffToApply>
    <exclusionTags>
      <li>OverclockChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T2Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>150</GR_Nanites>
      <ComponentSpacer>4</ComponentSpacer>
    </requiredMaterials>
    <workAmount>120</workAmount>
    <uiOrder>110</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_OverclockingChipAdvanced</defName>
    <label>Advanced overclocking chip</label>
    <description>A product that ignores all safe overclocking protocols. It requires sacrificing part of one's Zro capacity. Losing the Zro they rely on is enough for any Gray to understand the danger of this chip.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_OverclockingChipAdvanced</hediffToApply>
    <exclusionTags>
      <li>OverclockChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T3Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>300</GR_Nanites>
      <ComponentSpacer>10</ComponentSpacer>
    </requiredMaterials>
    <workAmount>120</workAmount>
    <uiOrder>120</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_OverclockingChipUltimate</defName>
    <label>Ultimate overclocking chip</label>
    <description>Hacks into the persona core, pushing energy supply to full load. An external Zro tank is almost mandatory. ...Even understanding what reduced Zro reserves means, the omnipotence of overclocking to the limit is still euphoric.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Brain</targetBodyPart>
    <hediffToApply>GR_Hediff_OverclockingChipUltimate</hediffToApply>
    <exclusionTags>
      <li>OverclockChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T4Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>500</GR_Nanites>
      <ComponentSpacer>25</ComponentSpacer>
      <GR_FundamentalCube>1</GR_FundamentalCube>
    </requiredMaterials>
    <workAmount>120</workAmount>
    <uiOrder>130</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <!-- ================================== 心脏插件 ================================== -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Heart_EfficiencyBooster</defName>
    <label>EfficiencyBooster</label>
    <description>An efficiency enhancer installed in the Gray Tide core that increases nanite recovery speed.</description>
    <targetBodyPart>Nano_Heart</targetBodyPart>
    <hediffToApply>GR_Hediff_EfficiencyBooster</hediffToApply>
    <researchPrerequisites>
      <li>GR_T3Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>200</GR_Nanites>
      <ComponentSpacer>10</ComponentSpacer>
      <Gold>100</Gold>
      <Luciferium>10</Luciferium>
    </requiredMaterials>
    <workAmount>1500</workAmount>
    <requiredSkill>Crafting</requiredSkill>
    <minSkillLevel>6</minSkillLevel>
    <uiOrder>30</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <!-- ================================== 眼部插件 ================================== -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Eye_TargetingSystem</defName>
    <label>TargetingSystem</label>
    <description>A target analysis and identification component compatible with all kinds of equipment. It effectively prevents friendly fire while providing reliable vector prediction. Knightly Gray often give it to their partners as a gift.</description>
    <targetBodyPartTags>
      <li>SightSource</li>
    </targetBodyPartTags>
    <hediffToApply>GR_Hediff_TargetingSystem</hediffToApply>
    <researchPrerequisites>
      <li>GR_T2Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <ComponentSpacer>1</ComponentSpacer>
      <GR_Nanites>20</GR_Nanites>
      <Silver>100</Silver>
    </requiredMaterials>
    <workAmount>1800</workAmount>
    <requiredSkill>Shooting</requiredSkill>
    <minSkillLevel>7</minSkillLevel>
    <uiOrder>50</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <!-- ================================== 手臂插件 ================================== -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_Arm_PrecisionChip</defName>
    <label>PrecisionChip</label>
    <description>A precision manipulation chip implanted in the arm that improves crafting accuracy and quality.</description>
    <targetBodyPart>MechanicalArm</targetBodyPart>
    <hediffToApply>GR_Hediff_PrecisionChip</hediffToApply>
    <researchPrerequisites>
      <li>GR_T3Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>100</GR_Nanites>
      <ComponentSpacer>10</ComponentSpacer>
      <Silver>100</Silver>
    </requiredMaterials>
    <workAmount>1200</workAmount>
    <requiredSkill>Crafting</requiredSkill>
    <minSkillLevel>5</minSkillLevel>
    <uiOrder>40</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <!-- ================================== 躯干插件 ================================== -->
  <!-- 灰潮源质存储器 -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_NanitesMemoryPrimary</defName>
    <label>Primary nanites memory</label>
    <description>As its name suggests, a storage unit for Zro. It raises the Gray's internal Zro storage capacity. It is designed in a small form that barely hinders movement.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Torso</targetBodyPart>
    <hediffToApply>GR_Hediff_NanitesMemoryPrimary</hediffToApply>
    <exclusionTags>
      <li>OverclockChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T1Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>20</GR_Nanites>
      <GR_Alloy>20</GR_Alloy>
      <ComponentIndustrial>10</ComponentIndustrial>
    </requiredMaterials>
    <workAmount>120</workAmount>
    <uiOrder>100</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_NanitesMemoryIntermediate</defName>
    <label>Intermediate nanites memory</label>
    <description>As its name suggests, a storage unit for Zro. Its larger size and manufacturing cost allow a more efficient compression method. It greatly increases storage capacity, while its well-controlled size and distribution do not affect movement.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Torso</targetBodyPart>
    <hediffToApply>GR_Hediff_NanitesMemoryIntermediate</hediffToApply>
    <exclusionTags>
      <li>OverclockChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T2Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>50</GR_Nanites>
      <GR_Alloy>50</GR_Alloy>
      <ComponentSpacer>2</ComponentSpacer>
    </requiredMaterials>
    <workAmount>120</workAmount>
    <uiOrder>110</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_NanitesMemoryAdvanced</defName>
    <label>Advanced nanites memory</label>
    <description>As its name suggests, a storage unit for Zro. This model is generally used only for transport. It hinders the Gray's mobility to some extent and also draws a small amount of core processing power to compress Zro.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Torso</targetBodyPart>
    <hediffToApply>GR_Hediff_NanitesMemoryAdvanced</hediffToApply>
    <exclusionTags>
      <li>OverclockChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T3Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>100</GR_Nanites>
      <GR_Alloy>100</GR_Alloy>
      <ComponentSpacer>5</ComponentSpacer>
    </requiredMaterials>
    <workAmount>120</workAmount>
    <uiOrder>120</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Plugin_NanitesMemoryUltimate</defName>
    <label>Ultimate nanites memory</label>
    <description>As its name suggests, a storage unit for Zro. It is basically only seen in transport operations for large-scale construction. A plugin of this level seriously affects core processing power and mobility—enough that some Gray regard it as punishment.</description>
    <!-- <iconPath>UI/Upgrades/CombatChip</iconPath> -->
    <targetBodyPart>Nano_Torso</targetBodyPart>
    <hediffToApply>GR_Hediff_NanitesMemoryUltimate</hediffToApply>
    <exclusionTags>
      <li>OverclockChip</li>
    </exclusionTags>
    <researchPrerequisites>
      <li>GR_T4Upgrades</li>
    </researchPrerequisites>
    <requiredMaterials>
      <GR_Nanites>200</GR_Nanites>
      <GR_Alloy>200</GR_Alloy>
      <ComponentSpacer>10</ComponentSpacer>
    </requiredMaterials>
    <workAmount>120</workAmount>
    <uiOrder>130</uiOrder>
  </SD.GrayRace.Defs.GRUpgradeDef>

</Defs>
