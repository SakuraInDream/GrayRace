  </SD.GrayRace.Defs.GRUpgradeDef>

  <!-- 推进器 -->
  <SD.GrayRace.Defs.GRUpgradeDef>
    <defName>GR_Transform_Torso_Thruster</defName>
    <label>Thruster</label>
    <description>.</description>
    <targetBodyPart>Torso</targetBodyPart>
    <hediffToApply>GR_Hediff_Thruster</hediffToApply>
    <researchPrerequisites>
      <li>GR_T3Upgrades</li>
