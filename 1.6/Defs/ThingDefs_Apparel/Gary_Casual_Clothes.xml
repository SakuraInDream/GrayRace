<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--女仆装-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Gray_Apparel_Maid</defName>
    <description>A long duster coat for blocking the sun and grit of the outdoors.</description>
    <label>Gray Maid</label>
    <possessionCount>1</possessionCount>
    <recipeMaker>
      <researchPrerequisite>ComplexClothing</researchPrerequisite>
      <displayPriority>215</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Apparel/Maid/Gray_Maid</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <costStuffCount>80</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>18000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.5</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <CleaningSpeed>1</CleaningSpeed>
      <AnimalGatherYield>0.25</AnimalGatherYield>
      <AnimalGatherSpeed>0.5</AnimalGatherSpeed>
      <PlantHarvestYield>0.25</PlantHarvestYield>
      <PlantWorkSpeed>0.5</PlantWorkSpeed>
      <FoodPoisonChance>-5</FoodPoisonChance>
      <CookSpeed>0.5</CookSpeed>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Hands</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Maid/Gray_Maid</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>GR_Work</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
  </ThingDef>

