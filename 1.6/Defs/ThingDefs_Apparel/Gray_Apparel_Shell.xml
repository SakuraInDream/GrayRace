<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--机械师装甲-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Gray_Apparel_MechanitorArmor</defName>
    <description>A long duster coat for blocking the sun and grit of the outdoors.</description>
    <label>Gray Mechanitor Armor</label>
    <techLevel>Ultra</techLevel>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Apparel/Mechanitor/Gray_MechanitorArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <thingCategories>
      <li>GR_ApparelArmor</li>
    </thingCategories>
    <recipeMaker>
      <researchPrerequisites>
        <li>GR_AdvancedCombatClothing</li>
        <li>GR_T2MechTech</li>
      </researchPrerequisites>
      <recipeUsers>
        <li>GR_NaniteReconfigurator</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <displayPriority>215</displayPriority>
    </recipeMaker>
    <costStuffCount>120</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <GR_Alloy>80</GR_Alloy>
      <GR_Nanites>40</GR_Nanites>
      <ComponentSpacer>15</ComponentSpacer>
    </costList>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToMake>240000</WorkToMake>
      <Mass>15</Mass>
      <StuffEffectMultiplierArmor>0.8</StuffEffectMultiplierArmor>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EnergyShieldRechargeRate>5</EnergyShieldRechargeRate>
      <EnergyShieldEnergyMax>0.01</EnergyShieldEnergyMax>
      <EquipDelay>4</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MechBandwidth>20</MechBandwidth>
      <MechRemoteShieldDistance>50</MechRemoteShieldDistance>
      <MechRemoteShieldEnergy>500</MechRemoteShieldEnergy>
    </equippedStatOffsets>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Hands</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Mechanitor/Gray_MechanitorArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>GR_AdvancedArmor</li>
        <li>GR_MechanitorArmor</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <colorGenerator Class="ColorGenerator_White" />
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Shield">
        <startingTicksToReset>300</startingTicksToReset>
        <minDrawSize>1.8</minDrawSize>
        <maxDrawSize>1.8</maxDrawSize>
        <energyLossPerDamage>0.01</energyLossPerDamage>
        <energyOnReset>0</energyOnReset>
        <blocksRangedWeapons>false</blocksRangedWeapons>
      </li>
    </comps>
  </ThingDef>

