<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--机械师背包-->
  <ThingDef ParentName="MechanitorPackBase">
    <defName>Gray_Apparel_MechanitorBelt</defName>
    <label>Gray auxiliary robotic arm</label>
    <description>The Four-Way Auxiliary Arm is a multifunctional expansion device commonly used by Gray mechanitors. As long as a part of oneself is injected into it, its four independent auxiliary cores can switch between manipulation, hauling, repair, or defense modes according to mission needs. All auxiliary arm movements are scheduled in real time by the secondary logic unit of the persona core, with almost no operational delay. After battle, one occasionally sees auxiliary arms that have detached from the main body due to damage yet still twitch—derisively called 'Gray Embers' by scavengers.</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisite>GR_T2MechTech</researchPrerequisite>
      <recipeUsers>
        <li>GR_NaniteReconfigurator</li>
      </recipeUsers>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <GR_Alloy>80</GR_Alloy>
      <GR_Nanites>60</GR_Nanites>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <graphicData>
      <texPath>Apparel/Mechanitor/Gray_MechanitorBelt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>3</Mass>
      <Flammability>0</Flammability>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <thingCategories>
      <li>GR_ApparelMisc</li>
    </thingCategories>
    <equippedStatOffsets>
      <MechBandwidth>12</MechBandwidth>
      <MechRepairSpeed>2</MechRepairSpeed>
      <SubcoreEncodingSpeed>1</SubcoreEncodingSpeed>
      <MeleeDamageFactor>0.4</MeleeDamageFactor>
      <GeneralLaborSpeed>0.5</GeneralLaborSpeed>
    </equippedStatOffsets>
    <apparel>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <mechanitorApparel>true</mechanitorApparel>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <wornGraphicPath>Apparel/Mechanitor/Gray_MechanitorBelt</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
      </wornGraphicData>
    </apparel>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>
</Defs>
