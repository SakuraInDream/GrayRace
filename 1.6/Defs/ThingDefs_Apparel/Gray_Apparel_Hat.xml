<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--机械师头盔-->
  <ThingDef ParentName="HatMakeableBase">
    <defName>Gray_Apparel_MechanitorHelmet</defName>
    <label>Gray Mechanitor Helmet</label>
    <description>Stylish yet rugged, this helmet keeps the sun and rain off - and it gives anyone who wears it a bit of extra charm. It is the most important part of traditional western attire.</description>
    <techLevel>Spacer</techLevel>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Apparel/Mechanitor/Gray_MechanitorHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <recipeMaker>
      <researchPrerequisites>
        <li>GR_AdvancedCombatClothing</li>
        <li>GR_T2MechTech</li>
      </researchPrerequisites>
      <recipeUsers>
        <li>GR_NaniteReconfigurator</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <displayPriority>215</displayPriority>
    </recipeMaker>
    <costStuffCount>60</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <GR_Alloy>40</GR_Alloy>
      <GR_Nanites>60</GR_Nanites>
      <ComponentSpacer>8</ComponentSpacer>
    </costList>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>18000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.8</StuffEffectMultiplierArmor>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
      <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MechBandwidth>50</MechBandwidth>
      <MechControlGroups>2</MechControlGroups>
      <MechFormingSpeed>5</MechFormingSpeed>
      <MechRemoteRepairDistance>50</MechRemoteRepairDistance>
      <SubcoreEncodingSpeed>2</SubcoreEncodingSpeed>
    </equippedStatOffsets>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Mechanitor/Gray_MechanitorHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <offset>(0,-0.15)</offset>
        </north>
        <south>
          <offset>(0,-0.15)</offset>
        </south>
        <east>
          <offset>(-0.35,-0.1)</offset>
        </east>
        <west>
          <offset>(0.35,-0.1)</offset>
        </west>
      </wornGraphicData>
      <tags>
        <li>GR_Combat</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
  </ThingDef>

</Defs>
