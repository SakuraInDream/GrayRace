      <li>Fabric</li>
    </stuffCategories>
    <costList>
      <GR_Nanites>50</GR_Nanites>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
