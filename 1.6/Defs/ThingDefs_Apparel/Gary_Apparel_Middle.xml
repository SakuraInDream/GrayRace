  <!--旗袍-->
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>Gray_Apparel_Qipao</defName>
    <description>She is the Gray Wind: an invincible commander, a diplomat who can debate a crowd into silence, an administrator who builds prosperity, and a scientist whose brilliance shines across the stars. She is also the pioneer of the Gray race and the faith of their people—and now she has come for you, ruler.</description>
    <label>Gray Qipao</label>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Apparel/Qipao/Gray_Qipao</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <MarketValue>100000</MarketValue>
      <Mass>0</Mass>
      <ArmorRating_Sharp>2</ArmorRating_Sharp>
      <ArmorRating_Blunt>2</ArmorRating_Blunt>
      <ArmorRating_Heat>2</ArmorRating_Heat>
      <EquipDelay>0</EquipDelay>
      <EnergyShieldRechargeRate>5</EnergyShieldRechargeRate>
      <EnergyShieldEnergyMax>50.0</EnergyShieldEnergyMax>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0</Flammability>
    </statBases>
    <equippedStatOffsets>
    </equippedStatOffsets>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Hands</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Qipao/Gray_Qipao</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
        <li>Middle</li>
      </layers>
      <tags>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Shield">
        <startingTicksToReset>600</startingTicksToReset>
        <minDrawSize>1.8</minDrawSize>
