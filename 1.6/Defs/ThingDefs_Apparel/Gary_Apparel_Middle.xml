  <!--使节服装-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Gray_Apparel_Envoy</defName>
    <description>Sometimes the Gray harbor an inexplicable obsession with their origin—the source of every Gray.\nIt is a feeling that cannot be understood just by looking. Only when actually wearing this uniquely cut gown does the persona core flash with several inexplicable currents, as if by instinct—and to the Gray, it is a tingling that unsettles the heart.\nLooking down at herself, she feels as if she has truly become the Gray Wind herself—and with that, she can command with confidence and cross verbal swords with anyone.</description>
    <label>Gray Envoy Dress</label>
    <graphicData>
      <texPath>Apparel/Envoy/Gray_Envoy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <thingCategories>
      <li>GR_ApparelSpecial</li>
    </thingCategories>
    <recipeMaker>
      <researchPrerequisites>
        <li>GR_ProfessionalClothing</li>
      </researchPrerequisites>
