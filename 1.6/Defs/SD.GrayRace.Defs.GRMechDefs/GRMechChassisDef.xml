<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 没做超空间引擎的槽，所以少 1 个槽，不懂 RW 里效果怎么体现 -->
  <SD.GrayRace.Defs.GRMechChassisDef Name="GR_ChassisBase" Abstract="True">
    <requiredComponentSlots>
      <li>
        <!-- key 是用来保存数据的，让模块知道安装在哪个槽位里，仿群星设计 -->
        <key>POWER_CORE_01</key>
        <label>反应堆</label>
        <slotDef>GR_MechSlot_PowerCore</slotDef>
        <anchorBodyPart>Reactor</anchorBodyPart>
        <uiOrder>10</uiOrder>
      </li>
      <li>
        <key>THRUSTER_01</key>
        <label>推进器</label>
        <slotDef>GR_MechSlot_Thruster</slotDef>
        <anchorBodyPart>MechanicalFoot</anchorBodyPart>
        <uiOrder>20</uiOrder>
      </li>
    </requiredComponentSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <!-- 都是仿群星的设计 -->
  <!-- 每制作一个 ChassisDef 就要创建一个 RecipeDef 绑定机械体 -->
  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Corvette</defName>
    <label>护卫舰</label>
    <description>护卫舰是最基础的战舰类型之一，具有武装，可以与敌人交战。</description>
    <pawnKindDef>GR_Mech_FF</pawnKindDef>
    <designerPreviewPath>Race/Mech/FF_south</designerPreviewPath>
    <fixedWorkTicks>6000</fixedWorkTicks>
    <uiOrder>0</uiOrder>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <!-- 像护卫舰只支持核心区段 -->
      <li>GR_MechSection_Mid</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Battleship</defName>
    <label>战列舰</label>
    <description>战列舰可搭载无可匹敌的火力，拥有最大的舰体规模，但成本高昂，机动性较差。</description>
    <!-- 这两个绑定对应的机械体 -->
    <pawnKindDef>GR_Mech_FF</pawnKindDef>
    <designerPreviewPath>Race/Mech/FF_south</designerPreviewPath>
    <fixedWorkTicks>60000</fixedWorkTicks>
    <uiOrder>4</uiOrder>
    <researchPrerequisites>
      <li>GR_T4MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <!-- 支持哪些区段（GRMechSectionSlotDef） -->
      <li>GR_MechSection_Bow</li>
      <li>GR_MechSection_Mid</li>
      <li>GR_MechSection_Stern</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Frigate</defName>
    <label>雷击舰</label>
    <description>雷击舰是护卫舰的一种先进衍生型号，专职发射鱼雷。他们更慢更脆弱，但可以对大型目标造成毁灭性的打击。</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_FF</pawnKindDef>
    <designerPreviewPath>Race/Mech/FF_south</designerPreviewPath>
    <fixedWorkTicks>6000</fixedWorkTicks>
    <uiOrder>1</uiOrder>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Mid</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Destroyer</defName>
    <label>驱逐舰</label>
    <description>采用双区段设计的驱逐舰可以提供多种多样的战略性武装。</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_DD</pawnKindDef>
    <designerPreviewPath>Race/Mech/DD_south</designerPreviewPath>
    <fixedWorkTicks>6000</fixedWorkTicks>
    <uiOrder>2</uiOrder>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Bow</li>
      <li>GR_MechSection_Stern</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Cruiser</defName>
    <label>巡洋舰</label>
    <description>巡洋舰采用三段式设计，在愿意加钱的情况下可自由进行各种追加模组改装。</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_CA</pawnKindDef>
    <designerPreviewPath>Race/Mech/CA_south</designerPreviewPath>
    <fixedWorkTicks>6000</fixedWorkTicks>
    <uiOrder>3</uiOrder>
    <researchPrerequisites>
      <li>GR_T3MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Bow</li>
      <li>GR_MechSection_Mid</li>
      <li>GR_MechSection_Stern</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Titan</defName>
    <label>泰坦</label>
    <description>这些巨型战舰是整个舰队的骄傲，泰坦上携带有多种武器，一般作为旗舰使用。</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_FF</pawnKindDef>
    <designerPreviewPath>Race/Mech/FF_south</designerPreviewPath>
    <fixedWorkTicks>6000</fixedWorkTicks>
    <uiOrder>5</uiOrder>
    <researchPrerequisites>
      <li>GR_T5MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Bow</li>
      <li>GR_MechSection_Mid</li>
      <li>GR_MechSection_Stern</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Juggernaut</defName>
    <label>主宰</label>
    <description>这些巨型构造物既是舰船也是空间站。主宰是一种庞大的可移动空间站，可以维修和建造舰船，也就是说，它可以作为进攻性战役中行动时的前进基地使用。</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_FF</pawnKindDef>
    <designerPreviewPath>Race/Mech/FF_south</designerPreviewPath>
    <fixedWorkTicks>6000</fixedWorkTicks>
    <uiOrder>6</uiOrder>
    <researchPrerequisites>
      <li>GR_T6MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Mid</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>
</Defs>
