<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <StatDef>
    <defName>GRStat_NaniteMax</defName>
    <label>备用灰潮源质上限</label>
    <description>灰裔体内能够储存的备用纳米机械最大值。</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>500</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <workerClass>SD.GrayRace.StatWorkers.StatWorker_GrayRace</workerClass>

    <!-- <parts>

    </parts> -->
  </StatDef>

  <StatDef>
    <defName>GRStat_NaniteRegenRate</defName>
    <label>备用灰潮源质回复率</label>
    <description>灰裔每秒自动回复的纳米机械数量。</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>1.0</defaultBaseValue>
    <toStringStyle>FloatTwo</toStringStyle>
    <workerClass>SD.GrayRace.StatWorkers.StatWorker_GrayRace</workerClass>

    <capacityFactors>
      <li>
        <capacity>BloodPumping</capacity>
      </li>
    </capacityFactors>

    <parts>
      <!-- 高速治疗消耗 Nanites -->
      <li Class="SD.GrayRace.StatWorkers.StatPart_NaniteDrain" />

      <!-- 根据 Need 自然恢复 Nanites -->
      <li Class="SD.GrayRace.StatWorkers.StatPart_NaniteGen">
        <curve>
          <points>
            <!-- 无能量时为 0 -->
            <li>(0, 0)</li>
            <li>(0.01, 0.1)</li>
            <li>(0.2, 0.5)</li>
            <li>(0.5, 0.8)</li>
            <li>(0.8, 1)</li>
          </points>
        </curve>
      </li>
    </parts>
  </StatDef>

  <StatDef>
    <defName>GRStat_OverclockMaxLevel</defName>
    <label>超频上限</label>
    <description>该灰裔当前部位可达到的最大超频比例。</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <workerClass>SD.GrayRace.StatWorkers.StatWorker_GrayRace</workerClass>
  </StatDef>
</Defs>
