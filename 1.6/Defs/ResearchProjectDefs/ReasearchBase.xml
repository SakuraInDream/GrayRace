  <!--Alloy Casting 合金铸造-->
  <ResearchProjectDef>
    <tab>GR_ResearchTab</tab>
    <defName>GR_AlloyCasting</defName>
    <label>Alloy Casting</label>
    <description>Unlocks the production of alloy. This space-age, high-quality metal offers near-perfect toughness, strength, and hardness, while also exhibiting exceptional malleability under specific conditions.</description>
    <baseCost>1000</baseCost>
    <prerequisites>
      <li>Electricity</li>
    </prerequisites>
    <discoveredLetterTitle>About: Alloy production formula</discoveredLetterTitle>
    <discoveredLetterText>先空着，傻逼泰南的科技联动显示太抽象了，后面写个说明</discoveredLetterText>
    <techLevel>Industrial</techLevel>
    <researchViewX>0</researchViewX>
    <researchViewY>3</researchViewY>
  </ResearchProjectDef>


