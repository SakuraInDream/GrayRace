<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>GR_Expectations</defName>
    <workerClass>ThoughtWorker_Expectations</workerClass>
    <stages>
      <li>
        <label>sky-high expectations</label>
        <description>Such a perfect colony! This is the masterpiece we built with our own hands!</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
      <li>
        <label>high expectations</label>
        <description>Our construction is almost complete!</description>
        <baseMoodEffect>18</baseMoodEffect>
      </li>
      <li>
        <label>moderate expectations</label>
        <description>Our colony is thriving!</description>
        <baseMoodEffect>24</baseMoodEffect>
      </li>
      <li>
        <label>low expectations</label>
        <description>Coming along nicely!</description>
        <baseMoodEffect>30</baseMoodEffect>
      </li>
      <li>
        <label>very low expectations</label>
        <description>Not bad, not bad! Looks proper!</description>
        <baseMoodEffect>36</baseMoodEffect>
      </li>
      <li>
        <label>extremely low expectations</label>
        <description>Whoa! A new colony, a new beginning!</description>
        <baseMoodEffect>42</baseMoodEffect>
      </li>

      <li>
        <label>noble expectations</label>
        <description>Noble...? Me? A noble?</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
      <li>
        <label>royal expectations</label>
        <description>If this position is bestowed by Her Majesty the Empress, I shall not fail in my duty.</description>
        <baseMoodEffect>0 </baseMoodEffect>
      </li>

      <li>
        <label>elite expectations</label>
        <description>I will make this position shine in my hands.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>supreme expectations</label>
        <description>They trust me... entrusted everything to me. I will not let them down.</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>

    </stages>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
  </ThoughtDef>

</Defs>
