<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--殖民者-->
  <PawnKindDef ParentName="Gray_PawnKindBase">
    <defName>GR_colonist</defName>
    <label>gray colonist</label>
    <combatPower>50</combatPower>
    <itemQuality>Excellent</itemQuality>
    <isFighter>true</isFighter>
    <factionLeader>false</factionLeader>
    <apparelMoney>500~2000</apparelMoney>
    <apparelTags>
      <li>GR_Underwear</li>
      <li>GR_Daily</li>
    </apparelTags>
    <apparelDisallowTags>
    </apparelDisallowTags>
    <weaponTags>
    </weaponTags>
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>GR_Adult</li>
          <li>GR_Child</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
    <inventoryOptions>
      <skipChance>0.25</skipChance>
      <subOptionsChooseOne>
        <li>
          <choiceChance>100</choiceChance>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>100</min>
            <max>500</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <defaultFactionType>Gray_PlayerFaction</defaultFactionType>
  </PawnKindDef>

  <!--平民-->
  <PawnKindDef ParentName="Gray_PawnKindBase">
    <defName>Gray_Citizen</defName>
    <label>gray citizen</label>
    <combatPower>50</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>false</isFighter>
    <factionLeader>false</factionLeader>
    <minGenerationAge Inherit="False">15</minGenerationAge>
    <apparelMoney>500~5000</apparelMoney>
    <apparelTags>
      <li>GR_Worker</li>
      <li>GR_Underwear</li>
    </apparelTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <requiredTag>GR_Worker</requiredTag>
      </li>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <requiredTag>GR_Underwear</requiredTag>
      </li>
    </specificApparelRequirements>
    <weaponMoney>2000~5000</weaponMoney>
    <weaponTags>
      <li>GR_BasicWeapon</li>
    </weaponTags>
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>GR_Adult</li>
          <li>GR_Child</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
    <inventoryOptions>
      <skipChance>0.25</skipChance>
      <subOptionsChooseOne>
        <li>
          <choiceChance>100</choiceChance>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>20</min>
            <max>75</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>

  <!--女仆-->
  <PawnKindDef ParentName="Gray_PawnKindBase">
    <defName>Gray_Maid</defName>
    <label>gray maid</label>
    <combatPower>70</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>false</isFighter>
    <factionLeader>false</factionLeader>
    <apparelMoney>500~2000</apparelMoney>
    <maxGenerationAge>30</maxGenerationAge>
    <minGenerationAge Inherit="False">10</minGenerationAge>
    <apparelTags>
      <li>GR_Maid</li>
    </apparelTags>
    <apparelDisallowTags>
    </apparelDisallowTags>
    <weaponTags>
    </weaponTags>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>GR_Maid</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>GR_Maid</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
  </PawnKindDef>

