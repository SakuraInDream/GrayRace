<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--士兵-->
  <PawnKindDef ParentName="Gray_PawnKindBase">
    <defName>Gray_Soldier</defName>
    <label>gray soldier</label>
    <combatPower>90</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>true</isFighter>
    <minGenerationAge Inherit="False">15</minGenerationAge>
    <apparelMoney>
      <min>99999</min>
      <max>99999</max>
    </apparelMoney>
    <apparelTags>
      <li>GR_Underwear</li>
      <li>GR_RangedArmor</li>
    </apparelTags>
    <apparelDisallowTags>
      <li>GR_MechanitorArmor</li>
    </apparelDisallowTags>
    <weaponMoney>99999~99999</weaponMoney>
    <weaponTags>
      <li>GR_BasicWeapon</li>
      <li>GR_T1Weapon</li>
    </weaponTags>
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>GR_Combat</li>
          <li>GR_Child</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
  </PawnKindDef>

