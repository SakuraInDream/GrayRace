    <!--泽珞-->
    <ThingDef ParentName="ResourceBase">
        <defName>GR_Zro</defName>
        <label>Zro</label>
        <description>An extremely rare aerosol of exotic particles. It has been deposited on a number of worlds through meteor impacts, but its true origin is a mystery. If ingested by psionically-gifted individuals, zro acts as a very potent (and addictive) drug that enhances PSI abilities.</description>
        <graphicData>
            <texPath>Things/Item/Resource/Zro</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Metal_Drop</soundDrop>
        <statBases>
            <MarketValue>30</MarketValue>
            <Mass>0.05</Mass>
            <StuffPower_Armor_Sharp>0.2</StuffPower_Armor_Sharp>
            <StuffPower_Armor_Blunt>0.1</StuffPower_Armor_Blunt>
            <StuffPower_Armor_Heat>0.1</StuffPower_Armor_Heat>
            <SharpDamageMultiplier>1.3</SharpDamageMultiplier>
            <BluntDamageMultiplier>0.3</BluntDamageMultiplier>
            <Flammability>0</Flammability>
        </statBases>
        <useHitPoints>false</useHitPoints>
        <healthAffectsPrice>false</healthAffectsPrice>
        <thingCategories>
            <li>ResourcesRaw</li>
        </thingCategories>
        <stackLimit>250</stackLimit>
        <smallVolume>true</smallVolume>
        <deepCommonality>0.1</deepCommonality>
        <deepCountPerPortion>8</deepCountPerPortion>
        <deepLumpSizeRange>1~4</deepLumpSizeRange>
        <burnableByRecipe>false</burnableByRecipe>
        <smeltable>true</smeltable>
        <stuffProps>
            <categories>
                <li>Metallic</li>
                <li>Fabric</li>
            </categories>
            <appearance>Metal</appearance>
            <commonality>1.00</commonality>
            <constructEffect>ConstructMetal</constructEffect>
            <color>(85,133,207)</color>
            <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
            <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
            <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
            <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
            <statOffsets>
                <Beauty>6</Beauty>
                <PsychicSensitivity>0.5</PsychicSensitivity>
            </statOffsets>
            <statFactors>
                <Mass>0.5</Mass>
                <MeleeWeapon_CooldownMultiplier>0.8</MeleeWeapon_CooldownMultiplier>
            </statFactors>
            <canSuggestUseDefaultStuff>false</canSuggestUseDefaultStuff>
            <statFactorsQuality>
                <li>
                    <stat>PsychicSensitivityFactor</stat>
                    <awful>1.06</awful>
                    <poor>1.08</poor>
                    <normal>1.1</normal>
                    <good>1.13</good>
                    <excellent>1.15</excellent>
                    <masterwork>1.17</masterwork>
                    <legendary>1.20</legendary>
                </li>
            </statFactorsQuality>
        </stuffProps>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <allowedArchonexusCount>80</allowedArchonexusCount>
    </ThingDef>

</Defs>