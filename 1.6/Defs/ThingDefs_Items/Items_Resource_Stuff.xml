<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--灰潮源质-->
    <ThingDef ParentName="ResourceBase">
        <defName>GR_Nanites</defName>
        <label>Nanites</label>
        <description>A simple and efficient nano-actuator capable of performing complex operations and experiments at the nanoscale.</description>
        <graphicData>
            <texPath>Things/Item/Resource/Nanites</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Metal_Drop</soundDrop>
        <statBases>
            <MarketValue>0</MarketValue>
            <Mass>0.001</Mass>
            <StuffPower_Armor_Sharp>0.8</StuffPower_Armor_Sharp>
            <StuffPower_Armor_Blunt>0.8</StuffPower_Armor_Blunt>
            <StuffPower_Armor_Heat>0.2</StuffPower_Armor_Heat>
            <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
            <StuffPower_Insulation_Heat>3</StuffPower_Insulation_Heat>
            <SharpDamageMultiplier>1.2</SharpDamageMultiplier>
            <BluntDamageMultiplier>0.5</BluntDamageMultiplier>
            <Flammability>0</Flammability>
        </statBases>
        <useHitPoints>false</useHitPoints>
        <healthAffectsPrice>false</healthAffectsPrice>
        <thingCategories>
            <li>ResourcesRaw</li>
        </thingCategories>
        <smallVolume>true</smallVolume>
        <stackLimit>5000</stackLimit>
        <burnableByRecipe>false</burnableByRecipe>
        <smeltable>true</smeltable>
        <stuffProps>
            <categories>
                <li>Metallic</li>
            </categories>
            <appearance>Metal</appearance>
            <commonality>1.00</commonality>
            <constructEffect>ConstructMetal</constructEffect>
            <color>(200,200,200)</color>
            <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
            <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
            <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
            <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
            <statFactors>
                <MaxHitPoints>0.5</MaxHitPoints>
                <Beauty>3</Beauty>
                <Flammability>0</Flammability>
                <Mass>0.1</Mass>
                <MeleeWeapon_CooldownMultiplier>0.8</MeleeWeapon_CooldownMultiplier>
                <WorkToMake>0.2</WorkToMake>
                <WorkTableWorkSpeedFactor>1.5</WorkTableWorkSpeedFactor>
            </statFactors>
            <canSuggestUseDefaultStuff>false</canSuggestUseDefaultStuff>
        </stuffProps>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <allowedArchonexusCount>5000</allowedArchonexusCount>
    </ThingDef>

    <!--合金-->
    <ThingDef ParentName="ResourceBase">
        <defName>GR_Alloy</defName>
        <label>Alloy</label>
        <description>This iconic material of the space age is synthesized from a nanoscale metallic matrix and rare interstellar minerals, combining exceptional strength with remarkable lightness. Its unique crystalline structure allows it to adapt to extreme temperatures, while its surface properties can be modulated via energy fields, making it suitable for a wide range of applications—from starship armor to colonial infrastructure.</description>
        <graphicData>
            <texPath>Things/Item/Resource/Alloys</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Metal_Drop</soundDrop>
        <statBases>
            <MarketValue>14</MarketValue>
            <Mass>0.25</Mass>
            <StuffPower_Armor_Sharp>2.0</StuffPower_Armor_Sharp>
            <StuffPower_Armor_Blunt>1.5</StuffPower_Armor_Blunt>
            <StuffPower_Armor_Heat>2.5</StuffPower_Armor_Heat>
            <StuffPower_Insulation_Cold>30</StuffPower_Insulation_Cold>
            <StuffPower_Insulation_Heat>30</StuffPower_Insulation_Heat>
            <SharpDamageMultiplier>1.8</SharpDamageMultiplier>
            <BluntDamageMultiplier>1.5</BluntDamageMultiplier>
            <Flammability>0</Flammability>
        </statBases>
        <useHitPoints>false</useHitPoints>
        <healthAffectsPrice>false</healthAffectsPrice>
        <thingCategories>
            <li>ResourcesRaw</li>
        </thingCategories>
        <burnableByRecipe>false</burnableByRecipe>
        <smeltable>true</smeltable>
        <stuffProps>
            <categories>
                <li>Metallic</li>
            </categories>
            <appearance>Metal</appearance>
            <commonality>1.00</commonality>
            <constructEffect>ConstructMetal</constructEffect>
            <color>(100,100,50)</color>
            <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
            <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
            <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
            <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
            <statFactors>
                <MaxHitPoints>10</MaxHitPoints>
                <Flammability>0</Flammability>
                <Mass>0.8</Mass>
                <MeleeWeapon_CooldownMultiplier>0.7</MeleeWeapon_CooldownMultiplier>
            </statFactors>
            <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
        </stuffProps>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <allowedArchonexusCount>80</allowedArchonexusCount>
    </ThingDef>

