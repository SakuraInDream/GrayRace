  <!-- 光矛 -->
  <SD.GrayRace.Defs.GRMechModuleDef Name="GR_MechModule_LancesBase" Abstract="True">
    <label>粒子光矛</label>
    <description>这些重型能量武器能够发射聚焦的粒子射线并造成巨幅伤害。发射阵列的规模限制了它们只能运用在战列舰和泰坦上。</description>
