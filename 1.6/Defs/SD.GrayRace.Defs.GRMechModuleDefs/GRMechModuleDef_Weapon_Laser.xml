  <!-- 红色激光 -->
  <SD.GrayRace.Defs.GRMechModuleDef Name="GR_MechModule_PulseLaser_InfraredBase" Abstract="True">
    <label>红色激光</label>
    <description>激光武器可以向目标发射聚焦光束，通过高热量给敌方造成伤害。</description>
    <iconPath>Icon/ShipParts/ship_part_laser_1</iconPath>
    <!-- slotFamily 用来解决同一武器的 S/M/L 切换问题 -->
    <slotFamily>PulseLaser_Infrared</slotFamily>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <uiOrder>0</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

  <SD.GrayRace.Defs.GRMechModuleDef ParentName="GR_MechModule_PulseLaser_InfraredBase">
    <defName>GR_MechModule_PulseLaser_Infrared</defName>
    <upgradesTo>
      <li>GR_MechModule_PulseLaser_Blue</li>
    </upgradesTo>
    <compatibleSlots>
      <li>GR_MechSlot_SmallTurret</li>
    </compatibleSlots>
    <costList>
      <GR_Alloy>10</GR_Alloy>
    </costList>
    <power>-5</power>
    <!-- 每个武器模块必须都要有一把对应的武器ThingDef -->
    <equipmentDef>GR_MechWeapon_PulseLaser_Infrared</equipmentDef>
    <weaponDeploymentTicks>30</weaponDeploymentTicks>
  </SD.GrayRace.Defs.GRMechModuleDef>

