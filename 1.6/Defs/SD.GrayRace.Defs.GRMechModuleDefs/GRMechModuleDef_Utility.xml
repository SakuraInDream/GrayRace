<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 护盾电容 -->
  <SD.GrayRace.Defs.GRMechModuleDef>
    <defName>GR_MechModule_ShieldBooster</defName>
    <label>Shield Capacitor</label>
    <description>A storage capacitor that can strengthen a ship's shields.</description>
    <iconPath>Icon/ShipParts/ship_part_shield_recharger</iconPath>
    <compatibleSlots>
      <li>GR_MechSlot_Auxiliary</li>
    </compatibleSlots>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
     <costList>
      <GR_Alloy>10</GR_Alloy>
    </costList>
    <power>-20</power>
    <statFactors>
      <EnergyShieldEnergyMax>1.1</EnergyShieldEnergyMax>
    </statFactors>
    <uiOrder>0</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

