    </costList>
    <power>-50</power>
    <statFactors>
      <EnergyShieldEnergyMax>1.25</EnergyShieldEnergyMax>
    </statFactors>
    <uiOrder>0</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

