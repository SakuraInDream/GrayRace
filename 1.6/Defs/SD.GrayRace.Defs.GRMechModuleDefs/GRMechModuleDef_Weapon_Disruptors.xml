  <!-- 相位裂解炮 -->
  <SD.GrayRace.Defs.GRMechModuleDef Name="GR_MechModule_Disruptor3Base" Abstract="True">
    <label>相位裂解炮</label>
    <description>这种极限强化版的裂解炮能够发射量子能，任何被命中的目标都会承受极大的伤害。</description>
