<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 裂解炮 -->
  <SD.GrayRace.Defs.GRMechModuleDef Name="GR_MechModule_Disruptor1Base" Abstract="True">
    <label>Disruptor</label>
    <description>The high-energy beam fired by a disruptor simultaneously weakens and breaks the molecular bonds holding the target's atoms together. It penetrates shields and armor, dealing devastating damage directly to hull and crew.</description>
    <iconPath>Icon/ShipParts/ship_part_laser_1</iconPath>
    <slotFamily>Disruptors</slotFamily>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <uiOrder>0</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

  <SD.GrayRace.Defs.GRMechModuleDef ParentName="GR_MechModule_Disruptor1Base">
    <defName>GR_MechModule_Disruptor1_S</defName>
    <upgradesTo>
      <li>GR_MechModule_Disruptor2_S</li>
    </upgradesTo>
    <compatibleSlots>
      <li>GR_MechSlot_SmallTurret</li>
    </compatibleSlots>
    <costList>
      <GR_Alloy>17</GR_Alloy>
    </costList>
    <power>-10</power>
    <equipmentDef>GR_MechWeapon_Disruptor1_S</equipmentDef>
    <weaponDeploymentTicks>30</weaponDeploymentTicks>
  </SD.GrayRace.Defs.GRMechModuleDef>

  <SD.GrayRace.Defs.GRMechModuleDef ParentName="GR_MechModule_Disruptor1Base">
    <defName>GR_MechModule_Disruptor1_M</defName>
    <upgradesTo>
      <li>GR_MechModule_Disruptor2_M</li>
    </upgradesTo>
    <compatibleSlots>
      <li>GR_MechSlot_MediumTurret</li>
    </compatibleSlots>
    <costList>
      <GR_Alloy>34</GR_Alloy>
    </costList>
    <power>-23</power>
    <equipmentDef>GR_MechWeapon_Disruptor1_M</equipmentDef>
    <weaponDeploymentTicks>45</weaponDeploymentTicks>
  </SD.GrayRace.Defs.GRMechModuleDef>

