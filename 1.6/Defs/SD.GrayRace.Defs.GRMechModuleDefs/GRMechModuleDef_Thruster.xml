<Defs>
  <SD.GrayRace.Defs.GRMechThrusterModuleDef Name="GR_MechModule_ThrusterBase" Abstract="True">
    <compatibleSlots>
      <li>GR_MechSlot_Thruster</li>
    </compatibleSlots>
    <anchorBodyPart>MechanicalFoot</anchorBodyPart>
  </SD.GrayRace.Defs.GRMechThrusterModuleDef>

  <SD.GrayRace.Defs.GRMechThrusterModuleDef Name="GR_MechModule_ThrusterTier_Chemical" ParentName="GR_MechModule_ThrusterBase" Abstract="True">
    <label>化学推进器</label>
    <description>简单而有效的化学助推器依靠可燃物推动机械体。</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_1</iconPath>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Thruster_Chemical</researchUnlockGroup>
    <uiOrder>4010</uiOrder>
  </SD.GrayRace.Defs.GRMechThrusterModuleDef>

  <SD.GrayRace.Defs.GRMechThrusterModuleDef Name="GR_MechModule_ThrusterTier_Ion" ParentName="GR_MechModule_ThrusterBase" Abstract="True">
    <label>离子推进器</label>
    <description>此种电推进器的推力来源于离子束，而非传统工质。</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_2</iconPath>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Thruster_Ion</researchUnlockGroup>
    <uiOrder>4020</uiOrder>
  </SD.GrayRace.Defs.GRMechThrusterModuleDef>

  <SD.GrayRace.Defs.GRMechThrusterModuleDef Name="GR_MechModule_ThrusterTier_Plasma" ParentName="GR_MechModule_ThrusterBase" Abstract="True">
    <label>等离子推进器</label>
    <description>等离子推进是电推进的高级形式，赋予舰船更快的亚光速航速和更好的机动性。</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_3</iconPath>
    <researchPrerequisites>
      <li>GR_T3MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Thruster_Plasma</researchUnlockGroup>
    <uiOrder>4030</uiOrder>
  </SD.GrayRace.Defs.GRMechThrusterModuleDef>

  <SD.GrayRace.Defs.GRMechThrusterModuleDef Name="GR_MechModule_ThrusterTier_Impulse" ParentName="GR_MechModule_ThrusterBase" Abstract="True">
    <label>脉冲推进器</label>
    <description>在亚光速条件下，此种高级聚变推进器可赋予舰船无与伦比的机动性和速度优势。</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_4</iconPath>
    <researchPrerequisites>
      <li>GR_T4MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Thruster_Impulse</researchUnlockGroup>
    <uiOrder>4040</uiOrder>
  </SD.GrayRace.Defs.GRMechThrusterModuleDef>

  <SD.GrayRace.Defs.GRMechThrusterModuleDef Name="GR_MechModule_ThrusterTier_DarkMatter" ParentName="GR_MechModule_ThrusterBase" Abstract="True">
    <label>暗物质推进器</label>
    <description>这些舰船推进器利用暗物质技术，以一种似乎违反了多个物理法则的方式来产生推进力。</description>
