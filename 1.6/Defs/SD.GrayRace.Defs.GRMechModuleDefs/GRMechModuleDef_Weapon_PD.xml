<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 点防御 -->
  <SD.GrayRace.Defs.GRMechModuleDef>
    <defName>GR_MechModule_PDArray1</defName>
    <label>Sentinel Point Defense</label>
    <description>For large, cumbersome warships, mounting anti-missile and anti-strike-craft defenses on the hull is essential.</description>
    <iconPath>Icon/ShipParts/ship_part_point_defense_1</iconPath>
    <upgradesTo>
      <li>GR_MechModule_PDArray2</li>
    </upgradesTo>
    <compatibleSlots>
      <li>GR_MechSlot_PointDefenseTurret</li>
    </compatibleSlots>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>8</GR_Alloy>
    </costList>
    <power>-5</power>
    <equipmentDef>GR_MechWeapon_PDArray</equipmentDef>
    <weaponDeploymentTicks>30</weaponDeploymentTicks>
    <uiOrder>0</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

  <SD.GrayRace.Defs.GRMechModuleDef>
    <defName>GR_MechModule_PDArray2</defName>
    <label>Barrier Point Defense</label>
    <description>Upgraded ballistic prediction algorithms improve tracking and point-defense effectiveness.</description>
    <iconPath>Icon/ShipParts/ship_part_point_defense_2</iconPath>
    <upgradesTo>
      <li>GR_MechModule_PDArray3</li>
    </upgradesTo>
    <compatibleSlots>
      <li>GR_MechSlot_PointDefenseTurret</li>
    </compatibleSlots>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>10</GR_Alloy>
    </costList>
    <power>-7</power>
    <!-- 占位 -->
    <equipmentDef>GR_MechWeapon_PDArray</equipmentDef>
    <weaponDeploymentTicks>30</weaponDeploymentTicks>
    <uiOrder>1</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

  <SD.GrayRace.Defs.GRMechModuleDef>
    <defName>GR_MechModule_PDArray3</defName>
    <label>Guardian Point Defense</label>
    <description>A diverse ammunition load significantly improves the ability to intercept threats.</description>
    <iconPath>Icon/ShipParts/ship_part_point_defense_3</iconPath>
    <compatibleSlots>
      <li>GR_MechSlot_PointDefenseTurret</li>
    </compatibleSlots>
    <researchPrerequisites>
      <li>GR_T3MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>10</GR_Alloy>
    </costList>
    <power>-10</power>
    <!-- 占位 -->
    <equipmentDef>GR_MechWeapon_PDArray</equipmentDef>
    <weaponDeploymentTicks>30</weaponDeploymentTicks>
    <uiOrder>2</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

</Defs>
