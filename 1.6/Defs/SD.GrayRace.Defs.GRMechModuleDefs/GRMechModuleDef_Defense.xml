      <GR_Alloy>5</GR_Alloy>
    </costList>
    <statOffsets>
      <ArmorRating_Sharp>0.01</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.01</ArmorRating_Blunt>
    </statOffsets>
    <uiOrder>5100</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

