  <SD.GrayRace.Defs.GRMechModuleDef ParentName="GR_MechModule_SmallShieldBase">
    <defName>GR_MechModule_Shield_S1</defName>
    <label>小型偏射盾</label>
    <description>能量偏射屏障可在过载前化解一定敌方火力，主要缺点是能耗高。</description>
    <iconPath>Icon/ShipParts/ship_part_shield_1</iconPath>
    <upgradeTo>GR_MechModule_Shield_S2</upgradeTo>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>5</GR_Alloy>
    </costList>
    <statOffsets>
      <EnergyShieldEnergyMax>1</EnergyShieldEnergyMax>
      <EnergyShieldRechargeRate>0.5</EnergyShieldRechargeRate>
    </statOffsets>
  </SD.GrayRace.Defs.GRMechModuleDef>

