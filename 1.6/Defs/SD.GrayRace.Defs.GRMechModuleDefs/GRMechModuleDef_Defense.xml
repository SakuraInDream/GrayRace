  <!-- 纳米装甲 -->
  <SD.GrayRace.Defs.GRMechModuleDef Name="GR_MechModule_Armor1Base" Abstract="True">
    <label>纳米装甲</label>
    <description>加强过的纳米装甲能够提供多一层的防护，有没有这一层防护，在战斗中可能就是生与死的区别。</description>
    <iconPath>Icon/ShipParts/ship_part_armor_1</iconPath>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <uiOrder>5100</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

