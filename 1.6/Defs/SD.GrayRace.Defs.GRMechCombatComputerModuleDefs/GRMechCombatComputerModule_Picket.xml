<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 哨戒 -->
  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef Name="GR_MechCombatComputer_PicketBase" ParentName="GR_MechCombatComputerBase" Abstract="True">
    <description>舰船将推进到中距离并尝试拦截迫近的敌舰。</description>
    <allowedChassis>
      <li>GR_Chassis_Corvette</li>
    </allowedChassis>
    <behavior>Picket</behavior>
    <weaponSelection>ShortestRange</weaponSelection>
    <positioning>HoldPreferredRange</positioning>
    <coverPreference>PreferCover</coverPreference>
    <preferredRangeFactor>0.75</preferredRangeFactor>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <!-- Picket -->
  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_PicketBase">
    <defName>GR_MechModule_CC_Picket_Basic</defName>
    <label>作战电脑(哨戒)</label>
    <upgradesTo>
      <li>GR_MechModule_CC_Picket_Advanced</li>
    </upgradesTo>
    <powerDraw>10</powerDraw>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>5</GR_Alloy>
    </costList>
    <statOffsets>
      <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
    </statOffsets>
    <statFactors>
      <RangedCooldownFactor>0.95</RangedCooldownFactor>
    </statFactors>
    <uiOrder>4300</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_PicketBase">
    <defName>GR_MechModule_CC_Picket_Advanced</defName>
    <label>高级作战电脑(哨戒)</label>
    <upgradesTo>
      <li>GR_MechModule_CC_Picket_Sapient</li>
      <!-- <li>GR_MechModule_CC_Picket_Autonomous</li> -->
      <li>GR_MechModule_CC_Picket_Precognitive</li>
    </upgradesTo>
    <powerDraw>15</powerDraw>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>10</GR_Alloy>
    </costList>
    <statOffsets>
      <ShootingAccuracyPawn>0.20</ShootingAccuracyPawn>
    </statOffsets>
    <statFactors>
      <RangedCooldownFactor>0.90</RangedCooldownFactor>
    </statFactors>
    <uiOrder>4301</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_PicketBase">
    <defName>GR_MechModule_CC_Picket_Sapient</defName>
    <label>智能作战电脑(哨戒)</label>
    <powerDraw>25</powerDraw>
    <researchPrerequisites>
      <li>GR_T3MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>20</GR_Alloy>
    </costList>
    <statOffsets>
      <ShootingAccuracyPawn>0.30</ShootingAccuracyPawn>
      <MeleeDodgeChance>0.10</MeleeDodgeChance>
    </statOffsets>
    <statFactors>
      <RangedCooldownFactor>0.85</RangedCooldownFactor>
    </statFactors>
    <uiOrder>4302</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

