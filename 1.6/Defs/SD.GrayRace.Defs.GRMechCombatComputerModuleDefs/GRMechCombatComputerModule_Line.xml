<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 线列 -->
  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef Name="GR_MechCombatComputer_LineBase" ParentName="GR_MechCombatComputerBase" Abstract="True">
    <description>舰船将推进到中距离并保持阵型目标。</description>
    <allowedChassis>
      <li>GR_Chassis_Battleship</li>
    </allowedChassis>
    <behavior>Line</behavior>
    <weaponSelection>LongestRange</weaponSelection>
    <positioning>HoldPreferredRange</positioning>
    <coverPreference>PreferCover</coverPreference>
    <preferredRangeFactor>0.85</preferredRangeFactor>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <!-- Line -->
  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_LineBase">
    <defName>GR_MechModule_CC_Line_Basic</defName>
    <label>作战电脑(线列)</label>
    <upgradesTo>
      <li>GR_MechModule_CC_Line_Advanced</li>
    </upgradesTo>
    <powerDraw>10</powerDraw>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>5</GR_Alloy>
    </costList>
    <statOffsets>
      <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
    </statOffsets>
    <statFactors>
      <RangedCooldownFactor>0.95</RangedCooldownFactor>
    </statFactors>
    <uiOrder>4400</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_LineBase">
