<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 蜂拥 -->
  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef Name="GR_MechCombatComputer_SwarmBase" ParentName="GR_MechCombatComputerBase" Abstract="True">
    <iconPath>Icon/ShipParts/ship_part_computer_role_swarm_basic</iconPath>
    <description>舰船将直接冲向敌人，在他们最短程武器的射程范围内尽可能多地对敌人造成伤害。</description>
    <allowedChassis>
      <li>GR_Chassis_Corvette</li>
    </allowedChassis>
    <behavior>Swarm</behavior>
    <weaponSelection>ShortestRange</weaponSelection>
    <positioning>CloseToPreferredRange</positioning>
    <coverPreference>IgnoreCover</coverPreference>
    <preferredRangeFactor>1.0</preferredRangeFactor>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <!-- Swarm -->
  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_SwarmBase">
    <defName>GR_MechModule_CC_Swarm_Basic</defName>
    <label>作战电脑（蜂拥）</label>
    <upgradesTo>
      <li>GR_MechModule_CC_Swarm_Advanced</li>
    </upgradesTo>
    <powerDraw>10</powerDraw>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>5</GR_Alloy>
    </costList>
    <statOffsets>
      <MeleeDodgeChance>0.05</MeleeDodgeChance>
    </statOffsets>
    <statFactors>
      <RangedCooldownFactor>0.95</RangedCooldownFactor>
    </statFactors>
    <uiOrder>4100</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_SwarmBase">
    <defName>GR_MechModule_CC_Swarm_Advanced</defName>
    <label>先进作战电脑（蜂拥）</label>
    <upgradesTo>
      <li>GR_MechModule_CC_Swarm_Sapient</li>
      <!-- <li>GR_MechModule_CC_Swarm_Autonomous</li> -->
      <li>GR_MechModule_CC_Swarm_Precognitive</li>
    </upgradesTo>
    <powerDraw>15</powerDraw>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>10</GR_Alloy>
    </costList>
    <statOffsets>
      <MeleeDodgeChance>0.10</MeleeDodgeChance>
    </statOffsets>
    <statFactors>
      <RangedCooldownFactor>0.90</RangedCooldownFactor>
    </statFactors>
    <uiOrder>4101</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_SwarmBase">
    <defName>GR_MechModule_CC_Swarm_Sapient</defName>
    <label>智慧作战电脑（蜂拥）</label>
    <powerDraw>25</powerDraw>
    <researchPrerequisites>
      <li>GR_T3MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>20</GR_Alloy>
    </costList>
    <statOffsets>
      <MeleeDodgeChance>0.25</MeleeDodgeChance>
    </statOffsets>
    <statFactors>
      <RangedCooldownFactor>0.85</RangedCooldownFactor>
    </statFactors>
    <uiOrder>4102</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

