  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_TorpedoBase">
    <defName>GR_MechModule_CC_Torpedo_Precognitive</defName>
    <label>预知接口(攻城)</label>
    <powerDraw>25</powerDraw>
    <researchPrerequisites>
      <li>GR_T4MechTech</li>
      <li>GR_Zro</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>20</GR_Alloy>
    </costList>
    <statOffsets>
      <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
