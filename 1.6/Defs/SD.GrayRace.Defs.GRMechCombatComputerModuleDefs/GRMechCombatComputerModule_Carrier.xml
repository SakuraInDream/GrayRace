<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 航母 -->
  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef Name="GR_MechCombatComputer_CarrierBase" ParentName="GR_MechCombatComputerBase" Abstract="True">
    <description>舰船会停留在其机库的最远交战半径上。</description>
    <allowedChassis>
      <li>GR_Chassis_Battleship</li>
    </allowedChassis>
    <behavior>Carrier</behavior>
    <weaponSelection>LongestRange</weaponSelection>
    <positioning>HoldPreferredRange</positioning>
    <coverPreference>IgnoreCover</coverPreference>
    <preferredRangeFactor>1.0</preferredRangeFactor>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <!-- Carrier -->
  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_CarrierBase">
    <defName>GR_MechModule_CC_Carrier_Basic</defName>
    <label>作战电脑(航母)</label>
    <upgradesTo>
      <li>GR_MechModule_CC_Carrier_Advanced</li>
    </upgradesTo>
    <powerDraw>10</powerDraw>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>5</GR_Alloy>
    </costList>
    <statFactors>
      <ShootingAccuracyFactor_Long>1.05</ShootingAccuracyFactor_Long>
    </statFactors>
    <uiOrder>4600</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_CarrierBase">
    <defName>GR_MechModule_CC_Carrier_Advanced</defName>
    <label>高级作战电脑(航母)</label>
    <upgradesTo>
      <li>GR_MechModule_CC_Carrier_Sapient</li>
      <li>GR_MechModule_CC_Carrier_Autonomous</li>
      <li>GR_MechModule_CC_Carrier_Precognitive</li>
    </upgradesTo>
    <powerDraw>15</powerDraw>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>10</GR_Alloy>
    </costList>
    <statFactors>
      <ShootingAccuracyFactor_Long>1.10</ShootingAccuracyFactor_Long>
    </statFactors>
    <uiOrder>4601</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_CarrierBase">
    <defName>GR_MechModule_CC_Carrier_Sapient</defName>
    <label>智能作战电脑(航母)</label>
    <powerDraw>25</powerDraw>
    <researchPrerequisites>
      <li>GR_T3MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>20</GR_Alloy>
    </costList>
    <statFactors>
      <ShootingAccuracyFactor_Long>1.15</ShootingAccuracyFactor_Long>
    </statFactors>
    <uiOrder>4602</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_CarrierBase">
    <defName>GR_MechModule_CC_Carrier_Autonomous</defName>
    <label>自主舰载智能(航母)</label>
    <powerDraw>25</powerDraw>
    <researchPrerequisites>
      <li>GR_T4MechTech</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>20</GR_Alloy>
    </costList>
    <statFactors>
      <ShootingAccuracyFactor_Long>1.15</ShootingAccuracyFactor_Long>
    </statFactors>
    <uiOrder>4603</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>

  <SD.GrayRace.Defs.GRMechCombatComputerModuleDef ParentName="GR_MechCombatComputer_CarrierBase">
    <defName>GR_MechModule_CC_Carrier_Precognitive</defName>
    <label>预知接口(航母)</label>
    <powerDraw>25</powerDraw>
    <researchPrerequisites>
      <li>GR_T4MechTech</li>
      <li>GR_Zro</li>
    </researchPrerequisites>
    <costList>
      <GR_Alloy>20</GR_Alloy>
    </costList>
    <statOffsets>
      <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
    </statOffsets>
    <statFactors>
      <ShootingAccuracyFactor_Long>1.15</ShootingAccuracyFactor_Long>
    </statFactors>
    <uiOrder>4604</uiOrder>
  </SD.GrayRace.Defs.GRMechCombatComputerModuleDef>
</Defs>
