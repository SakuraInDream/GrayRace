<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>Gray_Faction</defName>
    <label>&lt;color=#00ff9b>&lt;b>德萨努协约国&lt;/b>&lt;/color></label>
    <fixedName>&lt;color=#00ff9b>&lt;b>德萨努协约国&lt;/b>&lt;/color></fixedName>
    <description>灰裔先遣队据点。</description>
    <colorSpectrum>
      <li>(0,255,155)</li>
    </colorSpectrum>
    <categoryTag>Gray_Faction</categoryTag>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <pawnSingular>Gray</pawnSingular>
    <pawnsPlural>Grey</pawnsPlural>
    <listOrderPriority>30</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>false</canSiege>
    <canStageAttacks>false</canStageAttacks>
    <leaderTitle>governor</leaderTitle>
    <fixedLeaderKinds>
      <li>Gray_Leader</li>
    </fixedLeaderKinds>
    <factionIconPath>Icon/Faction/Gray</factionIconPath>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <techLevel>Archotech</techLevel>
    <melaninRange>0</melaninRange>    <!--黑皮肤概率，百分数-->
    <naturalEnemy>false</naturalEnemy>
    <permanentEnemy>false</permanentEnemy>
    <allowedCultures>
      <li>Astropolitan</li>
    </allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Collectivist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
    </requiredMemes>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Shipborn</li>
    </allowedMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">Lovin_Prohibited</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Lovin_Horrible</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Lovin_SpouseOnly_Strict</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Lovin_SpouseOnly_Moderate</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Lovin_SpouseOnly_Mild</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_UncoveredGroinChestHairOrFaceDisapproved</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_UncoveredGroinChestOrHairDisapproved</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_UncoveredGroinOrChestDisapproved</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_UncoveredGroinDisapproved</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">DrugUse_MedicalOnly</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">DrugUse_Prohibited</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NobleDespisedWeapons</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">PreferredXenotype</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HAR_AlienRaces_Abhorrent</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HAR_AlienRaces_Horrible</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HAR_AlienRaces_Respected</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HAR_AlienRaces_Exalted</li>
    </disallowedPrecepts>
    <xenotypeSet>
      <xenotypeChances>
        <GR_Xeno_Worker MayRequire="Ludeon.RimWorld.Biotech">0.5</GR_Xeno_Worker>
        <GR_Xeno_Soldier MayRequire="Ludeon.RimWorld.Biotech">0.5</GR_Xeno_Soldier>
      </xenotypeChances>
    </xenotypeSet>
    <backstoryCategories>
      <li>GR_Adult</li>
      <li>GR_Child</li>
    </backstoryCategories>
    <apparelStuffFilter>
      <stuffCategoriesToAllow>
        <li>Metallic</li>
        <li>Fabric</li>
      </stuffCategoriesToAllow>
      <disallowedThingDefs>
        <li>Silver</li>
        <li>Gold</li>
        <li>Uranium</li>
      </disallowedThingDefs>
    </apparelStuffFilter>
    <!-- <geneticVariance>0</geneticVariance> -->
    <caravanTraderKinds>
      <li>Caravan_Gray_BulkGoods</li>
      <li>Caravan_Gray_Exotic</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_Outlander_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_Outlander_Standard</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>-273~1453</allowedArrivalTemperatureRange>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(700, 120)</li>
        <li>(1000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Gray_Citizen>20</Gray_Citizen>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>1</commonality>
        <options>
          <Gray_Citizen>20</Gray_Citizen>
          <Gray_Leader>1</Gray_Leader>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>5</commonality>
        <options>
          <Gray_Citizen>18</Gray_Citizen>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>5</commonality>
        <options>
          <Gray_Citizen>15</Gray_Citizen>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Gray_Citizen>10</Gray_Citizen>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Gray_Trader>1</Gray_Trader>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
          <Alpaca>2</Alpaca>
          <Elephant>2</Elephant>
        </carriers>
        <guards>
          <Gray_Citizen>8</Gray_Citizen>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Gray_Citizen>20</Gray_Citizen>
          <Gray_Leader>1</Gray_Leader>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
  </FactionDef>

</Defs>
