<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 护卫舰 -->
  <ThingDef Name="GR_Mech" ParentName="LightMechanoid" Abstract="true">
    <statBases>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
      <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
      <EnergyShieldEnergyMax>0</EnergyShieldEnergyMax>
      <EnergyShieldRechargeRate>0</EnergyShieldRechargeRate>
      <StaggerDurationFactor>0</StaggerDurationFactor>
    </statBases>
    <modExtensions>
      <li Class="SD.GrayRace.HarmonyPatches.DisableNeeds">
        <disabledNeeds>
          <li>MechEnergy</li>
        </disabledNeeds>
      </li>
    </modExtensions>
    <race>
      <body>GR_MechBody</body>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>GR_Mechanoid</thinkTreeMain>
      <bulletStaggerDelayTicks>0</bulletStaggerDelayTicks>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <butcherProducts>
      <GR_Nanites>100</GR_Nanites>
      <GR_Alloy>20</GR_Alloy>
    </butcherProducts>
    <inspectorTabs>
      <li>SD.GrayRace.ITabs.ITab_GrayMechLoadout</li>
    </inspectorTabs>
    <comps>
      <li Class="SD.GrayRace.Comps.CompPropertiesGrayMechLoadout" />
      <li Class="SD.GrayRace.Comps.CompPropertiesMultiTurretGun" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="GR_Mech">
    <defName>GR_Mech_FF</defName>
    <label>巡空精魅</label>
    <description>巡空级是一种专注于大量制造和灵活支援战场的轻型机械体。作为灰裔对抗敌人的先遣部队，被大量的投入战场，发生紧急状况时也可快速支援。她具备「护卫」舰应有的速度与量产性，与她身上有些简约的护甲与火力，形成绝妙的平衡。正因为是量产型，纤细的躯体与手脚似乎还有待发育，可谓是相当稚嫩……虽说如此，从本就不多的护甲遮掩下，也已然能窥见女性的曲线了。</description>
    <statBases>
      <Mass>40</Mass>
      <MoveSpeed>12.7</MoveSpeed>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <BandwidthCost>1</BandwidthCost>
      <CaravanBonusSpeedFactor>16</CaravanBonusSpeedFactor>
    </statBases>
    <race>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>1.5</baseHealthScale>
      <mechWeightClass>Light</mechWeightClass>
    </race>
    <butcherProducts>
      <GR_Nanites>100</GR_Nanites>
      <GR_Alloy>20</GR_Alloy>
    </butcherProducts>
    <tools>
      <li>
        <label>fist</label>
        <capacities>
          <li>GR_NanoScratch</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_Shield">
        <compClass>SD.GrayRace.Comps.CompGrayMechVanillaShield</compClass>
        <blocksRangedWeapons>false</blocksRangedWeapons>
        <minDrawSize>1</minDrawSize>
        <maxDrawSize>1</maxDrawSize>
        <energyLossPerDamage>0.01</energyLossPerDamage>
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>GR_Mech_FF</defName>
    <label>巡空精魅</label>
    <race>GR_Mech_FF</race>
    <combatPower>100</combatPower>
    <maxPerGroup>20</maxPerGroup>
    <allowInMechClusters>true</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Race/Mech/FF</texPath>
          <maskPath>blank</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Race/Mech/FF</texPath>
          <maskPath>blank</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponMoney>1200~1200</weaponMoney>
    <weaponTags Inherit="False" />
  </PawnKindDef>

</Defs>
