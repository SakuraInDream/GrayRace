<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="Gray_PawnBase" ParentName="BasePawn" Abstract="True">
    <thingClass>Pawn</thingClass>
    <category>Pawn</category>
    <selectable>true</selectable>    <!--可选择-->
    <altitudeLayer>Pawn</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <hasTooltip>true</hasTooltip>    <!--有工具提示-->
    <soundImpactDefault>BulletImpact_Flesh</soundImpactDefault>
    <butcherProducts>      <!--屠宰产物-->
      <GR_Nanites>500</GR_Nanites>
    </butcherProducts>
    <statBases>
    </statBases>
    <inspectorTabs>
      <!-- 超频面板 -->
      <li>SD.GrayRace.ITabs.ITab_GrayRaceOverlock</li>
    </inspectorTabs>
  </ThingDef>

  <AlienRace.ThingDef_AlienRace ParentName="Gray_PawnBase">
    <defName>Gray_Race</defName>
    <label>Gray</label>
    <description>灰裔，是由纳米机械组成的生命体，借助人格核心和灰风的帮助获得了独立的意识与情感，成为具有自我认知的个体。她们曾是高效的杀戮机器，如今更专注于生产建设，战斗能力已大不如前。尽管拥有坚韧的机械身躯，但不能像灰风一样从被打散的状态重组，因此她们对死亡充满恐惧。</description>
    <alienRace>
      <generalSettings>
        <maleGenderProbability>0</maleGenderProbability>        <!--男性比例-->
        <immuneToAge>true</immuneToAge>        <!-- 不受年龄影响（老年病） -->
        <humanRecipeImport>true</humanRecipeImport>        <!--可使用人类手术配方-->
        <canLayDown>true</canLayDown>        <!-- 是否可以躺下睡觉（什么神经病功能，给半人马准备的是吧？） -->
        <maxDamageForSocialfight>5</maxDamageForSocialfight>        <!--最大打架伤害-->
        <immuneToXenophobia>true</immuneToXenophobia>        <!--禁用仇外主义-->
        <minAgeForAdulthood>15</minAgeForAdulthood>        <!--成年背景年龄-->
        <disallowedTraits>          <!--该种族禁用特性-->
          <li>
            <defName>Abrasive</defName>
          </li>
          <li>
            <defName>AnnoyingVoice</defName>
          </li>
          <li>
            <defName>Asexual</defName>
          </li>
          <li>
            <defName>BodyPurist</defName>
          </li>
          <li>
            <defName>CreepyBreathing</defName>
          </li>
          <li>
            <defName>DislikesMen</defName>
          </li>
          <li>
            <defName>Greedy</defName>
          </li>
          <li>
            <defName>Jealous</defName>
          </li>
          <li>
            <defName>Pyromaniac</defName>
          </li>
          <li>
            <defName>SlowLearner</defName>
          </li>
          <li>
            <defName Degree="-1">Beauty</defName>
          </li>
          <li>
            <defName Degree="-2">Beauty</defName>
          </li>
          <li>
            <defName>DrugDesire</defName>
          </li>
          <li>
            <defName>Immunity</defName>
          </li>
          <li>
            <defName>PsychicSensitivity</defName>
          </li>
          <li>
            <defName Degree="-1">Industriousness</defName>
          </li>
          <li>
            <defName Degree="-2">Industriousness</defName>
          </li>
        </disallowedTraits>
        <forcedRaceTraitEntries>          <!--种族必备特性-->
          <li>
            <defName>GreatMemory</defName>
            <chance>100</chance>
          </li>
          <li>
            <defName>GR_LearningAlgorithms</defName>
            <chance>10</chance>
          </li>
          <li>
            <defName>GR_Physicists</defName>
            <chance>10</chance>
          </li>
          <li>
            <defName>GR_Engineers</defName>
            <chance>10</chance>
          </li>
          <li>
            <defName>GR_Sociologists</defName>
            <chance>10</chance>
          </li>
        </forcedRaceTraitEntries>
        <!--=============================================外观相关==============================================-->
        <alienPartGenerator>
          <headTypes>            <!--头部的种类，动态表情貌似就是引用的这玩意做的脸？但是貌似空路径都没事，只要别空着，这玩意干嘛的，不会是什么泰南的神秘历史遗留吧-->
            <li>GR_Feature0</li>
            <li>GR_Feature1</li>
          </headTypes>
          <bodyTypes>            <!--体型-->
            <li>Female</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">Baby</li>            <!-- test -->
            <li MayRequire="Ludeon.RimWorld.Biotech">Child</li>            <!-- test -->
          </bodyTypes>
          <atlasScale>4</atlasScale>
          <borderScale>1</borderScale>
          <headOffset>(0.0, -0.35)</headOffset>          <!--头部贴图的偏移-->
          <headOffsetDirectional>
            <east>
              <offset>(-0.1, 0.0)</offset>
            </east>
            <west>
              <offset>(0.1, 0.0)</offset>
            </west>
          </headOffsetDirectional>
          <customDrawSize>(1, 1)</customDrawSize>          <!-- 生物的贴图的尺寸  -->
          <customHeadDrawSize>(1, 1)</customHeadDrawSize>          <!-- 生物的头部贴图的尺寸，发型与头盔也会按比例缩放  -->
          <customPortraitDrawSize>(1.0, 1.0)</customPortraitDrawSize>          <!-- 生物的肖像尺寸大小  -->
          <!--肤色发色-->
          <colorChannels Inherit="False">
            <li>
              <name>skin</name>
              <first Class="ColorGenerator_Options">
                <options>
                  <li>
                    <weight>100</weight>
                    <only>(255,255,255)</only>
                  </li>
                </options>
              </first>
              <second Class="AlienRace.ColorGenerator_CustomAlienChannel">
                <colorChannel>skin_1</colorChannel>
              </second>
            </li>
            <li>
              <name>hair</name>
              <first Class="ColorGenerator_Options">
                <options>
                  <li>
                    <weight>100</weight>
                    <only>(255,255,255)</only>
                  </li>
                </options>
              </first>
              <second Class="ColorGenerator_Single">
                <color>(255, 255, 255)</color>
              </second>
            </li>
          </colorChannels>
          <bodyAddons>            <!--  BodyPart，附加组件  -->
            <!--前发-->
            <li>
              <path>Race/Gray/Hair/Gray_Hair</path>
              <conditions>
                <BodyPart>
                  <bodyPart>Head</bodyPart>
                </BodyPart>
                <Apparel>
                  <hiddenUnderApparelTag>
                  </hiddenUnderApparelTag>
                </Apparel>
                <Posture>
                  <drawnStanding>true</drawnStanding>
                  <drawnInBed>true</drawnInBed>
                  <drawnLaying>true</drawnLaying>
                </Posture>
                <RotStage>Fresh,Rotting</RotStage>
              </conditions>
              <offsets>
                <west>
                  <layerOffset>-0.274</layerOffset>
                </west>
                <south>
                  <layerOffset>-0.274</layerOffset>
                </south>
                <north>
                  <layerOffset>0.22</layerOffset>
                </north>
                <east>
                  <layerOffset>-0.274</layerOffset>
                </east>
              </offsets>
              <inFrontOfBody>true</inFrontOfBody>
              <layerInvert>false</layerInvert>
              <alignWithHead>true</alignWithHead>
              <userCustomizable>true</userCustomizable>
              <defaultOffset>Center</defaultOffset>
              <drawSize>1</drawSize>
              <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
            </li>
            <!--后发-->
            <li>
              <path>Race/Gray/Hair/Gray_HairBack</path>
              <conditions>
                <BodyPart>
                  <bodyPart>Head</bodyPart>
                </BodyPart>
                <Posture>
                  <drawnStanding>true</drawnStanding>
                  <drawnInBed>false</drawnInBed>
                  <drawnLaying>true</drawnLaying>
                </Posture>
                <Apparel>
                  <hiddenUnderApparelTag>
                  </hiddenUnderApparelTag>
                </Apparel>
                <RotStage>Fresh,Rotting</RotStage>
              </conditions>
              <offsets>
                <west>
                  <layerOffset>-0.275</layerOffset>
                </west>
                <south>
                  <layerOffset>-0.299</layerOffset>
                </south>
                <north>
                  <layerOffset>-0.275</layerOffset>
                </north>
                <east>
                  <layerOffset>-0.275</layerOffset>
                </east>
              </offsets>
              <inFrontOfBody>false</inFrontOfBody>
              <layerInvert>false</layerInvert>
              <alignWithHead>true</alignWithHead>
              <userCustomizable>true</userCustomizable>
              <defaultOffset>Center</defaultOffset>
              <drawSize>1</drawSize>
              <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
              <linkVariantIndexWithPrevious>true</linkVariantIndexWithPrevious>
            </li>
          </bodyAddons>
        </alienPartGenerator>
        <reproduction>
          <maleFertilityAgeFactor>            <!--男性生育年龄因素-->
          </maleFertilityAgeFactor>
          <femaleFertilityAgeFactor>            <!--女性生育年龄因素-->
            <points>              <!-- 年龄,概率 -->
              <li>(10, 0)</li>
              <li>(16, 0)</li>
              <li>(28, 0)</li>
              <li>(35, 0)</li>
              <li>(40, 0)</li>
              <li>(45, 0)</li>
              <li>(50, 0)</li>
            </points>
          </femaleFertilityAgeFactor>
        </reproduction>
        <ageStatOverrides>          <!--年龄阶段属性-->
          <WorkSpeedGlobal>
            <useBiologicalYears>true</useBiologicalYears>
            <curve>
              <points>
                <li>(1,0.2)</li>
                <li>(7,0.5)</li>
                <li>(10,0.8)</li>
                <li>(15,1.0)</li>
              </points>
            </curve>
          </WorkSpeedGlobal>
        </ageStatOverrides>
        <growthAges>          <!--成长阶段(让你选技能带火和特性的那个窗口-->
          <li>4</li>
          <li>7</li>
          <li>10</li>
        </growthAges>
      </generalSettings>
      <compatibility>
        <isFlesh>false</isFlesh>
        <hasBlood>false</hasBlood>
      </compatibility>
      <graphicPaths>        <!--身体贴图的路径-->
        <head>Race/Gray/Head/</head>
        <body>
          <ageGraphics>
            <HumanlikeAdult>Race/Gray/Body/Naked_Female</HumanlikeAdult>
            <HumanlikeTeenager>Race/Gray/Body/Naked_Female</HumanlikeTeenager>
            <HumanlikePreTeenager>Race/Gray/Body/Naked_Child</HumanlikePreTeenager>
            <HumanlikeChild>Race/Gray/Body/Naked_Baby</HumanlikeChild>
            <HumanlikeBaby>Race/Gray/Body/Naked_Baby</HumanlikeBaby>
          </ageGraphics>
        </body>
        <skeleton>Things/Pawn/Humanlike/Bodies/Dessicated/Dessicated_Thin</skeleton>        <!--风干骷髅的贴图-->
        <swaddle>blank</swaddle>        <!--襁褓贴图-->
      </graphicPaths>
      <styleSettings>        <!--生物的风格设置-->
        <li>
          <key>HairDef</key>          <!--发型-->
          <value>
            <hasStyle>false</hasStyle>
          </value>
        </li>
        <li>
          <key>BeardDef</key>          <!--胡子-->
          <value>
            <hasStyle>false</hasStyle>
          </value>
        </li>
        <li>
          <key>TattooDef</key>          <!--纹身-->
          <value>
            <hasStyle>false</hasStyle>
          </value>
        </li>
      </styleSettings>

      <relationSettings>        <!--碰到以下关系的概率(设置0避免莫名其妙多个出父母亲戚)-->
        <relationChanceModifierChild>0</relationChanceModifierChild>
        <relationChanceModifierExLover>0</relationChanceModifierExLover>
        <relationChanceModifierExSpouse>0</relationChanceModifierExSpouse>
        <relationChanceModifierFiance>0</relationChanceModifierFiance>
        <relationChanceModifierLover>0</relationChanceModifierLover>
        <relationChanceModifierParent>0</relationChanceModifierParent>
        <relationChanceModifierSibling>0</relationChanceModifierSibling>
        <relationChanceModifierSpouse>0</relationChanceModifierSpouse>
      </relationSettings>
      <thoughtSettings>        <!--想法设置-->
        <replacerList>
          <li>
            <original>KnowColonistDied</original>
            <replacer>GR_KnowCompatriotDied</replacer>
          </li>
          <li>
            <original>WitnessedDeathAlly</original>
            <replacer>GR_WitnessedDeathAlly</replacer>
          </li>
        </replacerList>
        <cannotReceiveThoughts>
          <li>AteWithoutTable</li>
          <li>ButcheredHumanlikeCorpse</li>
          <li>HarvestedOrgan_Bloodlust</li>
          <li>KilledHumanlikeBloodlust</li>
          <li>KnowButcheredHumanlikeCorpse</li>
          <li>ObservedLayingCorpse</li>
          <li>ObservedLayingRottingCorpse</li>
          <li>SleepDisturbed</li>
          <li>SoakingWet</li>
          <li>WitnessedDeathBloodlust</li>
          <li>DeadMansApparel</li>
          <li>Ugly</li>
          <li>Pretty</li>
          <li>RotStink</li>
          <li>ToxicFallout</li>
        </cannotReceiveThoughts>
      </thoughtSettings>
      <!-- ================================================= 种族限定设置 ================================================= -->
      <raceRestriction>
        <onlyUseRaceRestrictedApparel>true</onlyUseRaceRestrictedApparel>        <!-- 只使用种族限制服装 -->
        <apparelList>
          <li>Gray_Apparel_MechanitorHelmet</li>
          <li>Gray_Apparel_MechanitorArmor</li>
          <li>Gray_Apparel_MechanitorISA</li>
          <li>Gray_Apparel_MarksmanHelmet</li>
          <li>Gray_Apparel_MarksmanArmor</li>
          <li>Gray_Apparel_MeleeHelmet</li>
          <li>Gray_Apparel_MeleeArmor</li>
          <li>Gray_Apparel_LightHelmet</li>
          <li>Gray_Apparel_LightArmor</li>
          <li>Gray_Apparel_HeavyHelmet</li>
          <li>Gray_Apparel_HeavyArmor</li>
          <li>Gray_Apparel_UniversalISA</li>
          <li>Gray_Apparel_CrewUniformA</li>
          <li>Gray_Apparel_CrewUniformB</li>
          <li>Gray_Apparel_CrewUniformC</li>
          <li>Gray_Apparel_NileGauze</li>
          <li>Gray_Apparel_StrangeNurse</li>
          <li>Gray_Apparel_BanquetDress</li>
          <li>Gray_Apparel_MikoOutfit</li>
        </apparelList>
        <whiteApparelList>
          <li>Gray_Apparel_MechanitorBelt</li>
        </whiteApparelList>
        <weaponList>
          <li>GR_RailCannon</li>
          <li>GR_HFMurasama</li>
          <li>GR_ShipSlayer</li>
        </weaponList>
        <blackGeneTags>          <!-- 禁用基因标签 -->
          <li>HairStyle</li>
          <li>Fur</li>
          <li>BeardStyle</li>
          <li>SkinColor</li>
        </blackGeneTags>
        <blackEndoCategories>          <!-- 黑名单基因类别 -->
          <li>HairColor</li>
          <li>Jaw</li>
          <li>Head</li>
          <li>BodyType</li>
        </blackEndoCategories>
      </raceRestriction>
    </alienRace>
    <!-- ================================================= 下面的就不是外星人特色功能了 ================================================= -->
    <statBases>      <!--基础值设定-->
      <MarketValue>8000</MarketValue>      <!--价值-->
      <MoveSpeed>7</MoveSpeed>      <!--移动速度-->
      <Flammability>-10</Flammability>      <!--可燃率-->
      <ToxicResistance>10</ToxicResistance>      <!--毒素抗性-->
      <ComfyTemperatureMin>-273</ComfyTemperatureMin>      <!--最低舒适温度-->
      <ComfyTemperatureMax>1453</ComfyTemperatureMax>      <!--最高舒适温度-->
      <Mass>10</Mass>      <!--质量-->
      <MeatAmount>50</MeatAmount>      <!--肉量-->
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Heat>2.00</ArmorRating_Heat>
      <CarryingCapacity>500</CarryingCapacity>      <!--携带能力-->
      <MentalBreakThreshold>0.35</MentalBreakThreshold>      <!--崩溃阈值-->
      <PainShockThreshold>0.6</PainShockThreshold>      <!--疼痛休克阈值-->
      <PsychicSensitivity>0.01</PsychicSensitivity>      <!--心灵敏感度-->
      <FilthRate>0</FilthRate>      <!--污物规模-->
      <!--战斗-->
      <MeleeDodgeChance>2</MeleeDodgeChance>      <!--近战闪避几率-->
      <MeleeHitChance>2</MeleeHitChance>      <!--近战命中率-->
      <AimingDelayFactor>0.8</AimingDelayFactor>      <!--瞄准时间-->
      <ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>      <!--射击精准度-->
      <!--社交-->
      <NegotiationAbility>0.8</NegotiationAbility>      <!--谈判能力-->
      <SellPriceFactor>2</SellPriceFactor>      <!--出售价格-->
      <SocialImpact>0.8</SocialImpact>      <!--社交影响力-->
      <!--生产-->
      <ButcheryMechanoidEfficiency>1.5</ButcheryMechanoidEfficiency>      <!--机械体拆解效率-->
      <ButcheryMechanoidSpeed>1.5</ButcheryMechanoidSpeed>      <!--机械体拆解速度-->
      <SmeltingSpeed>1.5</SmeltingSpeed>      <!--熔炼速度-->
      <GeneralLaborSpeed>1.5</GeneralLaborSpeed>      <!--普通工作速度-->
      <WorkSpeedGlobal>1.5</WorkSpeedGlobal>      <!--全局工作速度-->
      <!--烹饪-->
      <FoodPoisonChance>500</FoodPoisonChance>      <!--食物中毒几率-->
      <!--医学/研究-->
      <ResearchSpeed>2</ResearchSpeed>      <!--研究速度-->
      <MedicalTendQuality>1.5</MedicalTendQuality>      <!--医疗质量-->
      <MedicalSurgerySuccessChance>2</MedicalSurgerySuccessChance>      <!--手术成功率-->
      <GlobalLearningFactor>2.0</GlobalLearningFactor>      <!--全局学习系数-->
      <!--劳作-->
      <MiningSpeed>2</MiningSpeed>      <!--采矿速度-->
      <ConstructionSpeed>1.5</ConstructionSpeed>      <!--建造速度-->
      <ConstructSuccessChance>10</ConstructSuccessChance>      <!--建造成功率-->
      <FixBrokenDownBuildingSuccessChance>10</FixBrokenDownBuildingSuccessChance>      <!--修理成功率-->
      <TameAnimalChance>0.5</TameAnimalChance>      <!--驯服成功率-->
      <TrainAnimalChance>0.5</TrainAnimalChance>      <!--训练成功率-->
      <!--其他-->
      <RoyalFavorValue>14</RoyalFavorValue>      <!--皇权声望-->
      <LearningRateFactor>5</LearningRateFactor>      <!--儿童学习速度-->
      <!-- 纳米机械 Comp 迁移 StatDef -->
      <GRStat_NaniteMax>500</GRStat_NaniteMax>
      <GRStat_NaniteRegenRate>0.1</GRStat_NaniteRegenRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>GR_Nanites</thingToSpawn>
        <spawnCount>100</spawnCount>
        <spawnIntervalRange>60000</spawnIntervalRange>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <showMessageIfOwned>true</showMessageIfOwned>
      </li>
      <!-- 纳米机械Comp -->
      <!-- <li Class="SD.GrayRace.CompProperties_Nanites"> -->
      <li Class="SD.GrayRace.Comps.CompProperties_Nanites">
        <!-- 弃用，改用 StatDef GRStat_NaniteMax -->
        <!-- <maxResource>5</maxResource> -->
        <!-- 弃用，改用 StatDef GRStat_NaniteRegenRate -->
        <!-- <regenPerSecond>0.001</regenPerSecond> -->
        <!-- 资源名称，可本地化 -> <DefNAME.comps.CompResource_Nanites.resourceLabel> -->
        <resourceLabel>备用灰潮源质</resourceLabel>
        <!-- gizmo 的下方刻度显示 -->
        <resourceGizmoThresholds>
          <li>0.25</li>
          <li>0.5</li>
          <li>0.75</li>
        </resourceGizmoThresholds>
      </li>
      <!-- 超频系统 -->
      <li Class="SD.GrayRace.Comps.CompProperties_Overclock" />
    </comps>
    <damageMultipliers>
      <li>
        <damageDef>GR_NanoScratch</damageDef>
        <multiplier>0</multiplier>
      </li>
      <li>
        <damageDef>GR_NanoBullet</damageDef>
        <multiplier>0</multiplier>
      </li>
    </damageMultipliers>
    <!--==맨손전투===================================================================================================================-->
    <tools>      <!--空手攻击的设置-->
      <li>
        <label>left fist</label>
        <capacities>
          <li>GR_NanoScratch</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right fist</label>
        <capacities>
          <li>GR_NanoScratch</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>
    <!--=============================================================================================================================-->
    <race>
      <thinkTreeMain>Humanlike</thinkTreeMain>
      <thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
      <intelligence>Humanlike</intelligence>      <!--智力:人-->
      <makesFootprints>true</makesFootprints>      <!--留下脚印:是-->
      <lifeExpectancy>5000</lifeExpectancy>      <!--平均寿命-->
      <nameCategory>HumanStandard</nameCategory>      <!--名称限定-->
      <hasGenders>true</hasGenders>      <!--有性别-->
      <body>Gray</body>      <!-- body -->
      <renderTree>Humanlike</renderTree>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <specificMeatDef>GR_GrayFlesh</specificMeatDef>
      <baseBodySize>1</baseBodySize>      <!--体型大小-->
      <baseHealthScale>3</baseHealthScale>
      <foodType>None</foodType>      <!--不吃，杂食（人类默认）为OmnivoreHuman-->
      <gestationPeriodDays>5000</gestationPeriodDays>      <!--妊娠期天数 -->
      <soundCallIntervalRange>2000~5000</soundCallIntervalRange>
      <canBecomeShambler>true</canBecomeShambler>
      <knowledgeCategory MayRequire="Ludeon.RimWorld.Anomaly">Basic</knowledgeCategory>
      <anomalyKnowledge>1</anomalyKnowledge>
      <litterSizeCurve>        <!-- 初生婴儿年龄 -->
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1.00)</li>
          <li>(2, 0.07)</li>
          <li>(3, 0.02)</li>
          <li>(4, 0.01)</li>
          <li>(5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>        <!-- 年龄阶段，最好和成长阶段匹配，否则会被清空学习进度 -->
        <li Class="AlienRace.LifeStageAgeAlien">
          <def>HumanlikeBaby</def>
          <minAge>0</minAge>
          <headOffset>(0, -0.35)</headOffset>
          <headFemaleOffset>(0, -0.35)</headFemaleOffset>
