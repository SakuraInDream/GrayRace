<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 战列舰 -->
  <ThingDef ParentName="GR_Mech">
    <defName>GR_Mech_BB</defName>
    <label>Verdict Princess</label>
    <description>The Verdict-class is a heavy mechanoid specialized in long-range combat. ...Just by looking at her, one can tell this chassis has fully matured. No trace of immaturity remains; she has completely shed her green form. Firepower, armor, and shields are all at fully mature levels, and fitting possibilities have opened up at once. As long as enough of them are fielded, any problem will be solved.</description>
    <statBases>
      <Mass>135</Mass>
      <MoveSpeed>6</MoveSpeed>
      <ArmorRating_Blunt>0.7</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.7</ArmorRating_Sharp>
      <MeleeHitChance>32</MeleeHitChance>
      <BandwidthCost>8</BandwidthCost>
      <CaravanBonusSpeedFactor>10</CaravanBonusSpeedFactor>
    </statBases>
    <race>
      <baseBodySize>8</baseBodySize>
      <baseHealthScale>12</baseHealthScale>
      <mechWeightClass>Heavy</mechWeightClass>
    </race>
    <butcherProducts>
      <GR_Nanites>800</GR_Nanites>
      <GR_Alloy>160</GR_Alloy>
    </butcherProducts>
    <tools>
      <li>
        <label>fist</label>
        <capacities>
          <li>GR_NanoScratch</li>
        </capacities>
        <power>80</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_Shield">
        <compClass>SD.GrayRace.Comps.CompGrayMechVanillaShield</compClass>
        <blocksRangedWeapons>false</blocksRangedWeapons>
        <minDrawSize>4</minDrawSize>
        <maxDrawSize>4</maxDrawSize>
        <energyLossPerDamage>0.01</energyLossPerDamage>
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>GR_Mech_BB</defName>
    <label>Verdict Princess</label>
    <race>GR_Mech_BB</race>
    <combatPower>800</combatPower>
    <maxPerGroup>5</maxPerGroup>
    <allowInMechClusters>true</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Race/Mech/CA</texPath>
          <maskPath>blank</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Race/Mech/CA</texPath>
          <maskPath>blank</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponMoney>1200~1200</weaponMoney>
    <weaponTags Inherit="False" />
  </PawnKindDef>

</Defs>
