<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 驱逐舰 -->
  <ThingDef ParentName="LightMechanoid">
    <defName>GR_Mech_DD</defName>
    <label>强袭精灵</label>
    <description>强袭级是以擅长作为前锋突进作战为傲的中型机械体，以抵近射击为作战方针。虽相比于护卫舰，外观上没有太大差异，但其火力、装甲以及本质都获得了成长。像是进入青春期般，身上那些未熟的性征开始逐渐发育，表现出未来的可能性。作为战争机器——那正趋于成熟的美丽，与这份美丽截然相反的作战方式，让敌人和伙伴在面对她时，比起对美丽的惊艳，更多的是一份畏惧。</description>
    <statBases>
      <MoveSpeed>9</MoveSpeed>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
      <BandwidthCost>2</BandwidthCost>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
      <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
      <EnergyShieldEnergyMax>0</EnergyShieldEnergyMax>
      <EnergyShieldRechargeRate>0</EnergyShieldRechargeRate>
    </statBases>
    <race>
      <body>GR_MechBody</body>
      <baseBodySize>2</baseBodySize>
      <baseHealthScale>3</baseHealthScale>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>GR_Mechanoid</thinkTreeMain>
      <mechWeightClass>Medium</mechWeightClass>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <butcherProducts>
      <GR_Nanites>200</GR_Nanites>
      <GR_Alloy>40</GR_Alloy>
    </butcherProducts>
    <inspectorTabs>
      <li>SD.GrayRace.ITabs.ITab_GrayMechLoadout</li>
    </inspectorTabs>
    <comps>
      <li Class="SD.GrayRace.Comps.CompPropertiesGrayMechLoadout" />
      <li Class="CompProperties_Shield">
        <compClass>SD.GrayRace.Comps.CompGrayMechVanillaShield</compClass>
        <blocksRangedWeapons>false</blocksRangedWeapons>
      </li>
      <li Class="SD.GrayRace.Comps.CompPropertiesMultiTurretGun">
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>GR_Mech_DD</defName>
    <label>强袭精灵</label>
    <race>GR_Mech_DD</race>
    <combatPower>200</combatPower>
    <maxPerGroup>20</maxPerGroup>
    <allowInMechClusters>true</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Race/Mech/DD</texPath>
          <maskPath>blank</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Race/Mech/DD</texPath>
          <maskPath>blank</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponMoney>1200~1200</weaponMoney>
    <weaponTags Inherit="False" />
  </PawnKindDef>

</Defs>
