<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 巡洋舰 -->
  <ThingDef ParentName="GR_Mech">
    <defName>GR_Mech_CA</defName>
    <label>Drive Fairy</label>
    <description>The Drive-class is a medium mechanoid specialized in medium-range combat. Her appearance still retains a girl's freshness, yet her body has grown greatly, giving off a pure sense of inaccessibility. Just like her appearance, her firepower has risen considerably while her speed has not dropped much, so approaching her must be difficult. Judging by her rate of fire, if she were not a war machine, she would probably be a popular and diligent worker.</description>
    <statBases>
      <Mass>90</Mass>
      <MoveSpeed>7</MoveSpeed>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
      <MeleeHitChance>16</MeleeHitChance>
      <BandwidthCost>4</BandwidthCost>
      <CaravanBonusSpeedFactor>12</CaravanBonusSpeedFactor>
    </statBases>
    <race>
      <baseBodySize>4</baseBodySize>
      <baseHealthScale>6</baseHealthScale>
      <mechWeightClass>Medium</mechWeightClass>
    </race>
    <butcherProducts>
      <GR_Nanites>400</GR_Nanites>
      <GR_Alloy>80</GR_Alloy>
    </butcherProducts>
    <tools>
      <li>
        <label>fist</label>
        <capacities>
          <li>GR_NanoScratch</li>
        </capacities>
        <power>40</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_Shield">
        <compClass>SD.GrayRace.Comps.CompGrayMechVanillaShield</compClass>
        <blocksRangedWeapons>false</blocksRangedWeapons>
        <minDrawSize>3.5</minDrawSize>
        <maxDrawSize>3.5</maxDrawSize>
        <energyLossPerDamage>0.01</energyLossPerDamage>
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>GR_Mech_CA</defName>
    <label>Drive Fairy</label>
    <race>GR_Mech_CA</race>
    <combatPower>400</combatPower>
    <maxPerGroup>10</maxPerGroup>
    <allowInMechClusters>true</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Race/Mech/CA</texPath>
          <maskPath>blank</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.5</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Race/Mech/CA</texPath>
          <maskPath>blank</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.5</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponMoney>1200~1200</weaponMoney>
    <weaponTags Inherit="False" />
  </PawnKindDef>

</Defs>
