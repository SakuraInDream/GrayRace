<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef ParentName="LightMechanoidRecipe">
    <defName>GR_Mech_FF</defName>
    <label>护卫舰</label>
    <description>Assemble a Gray interceptor frigate from a predefined drydock package.</description>
    <researchPrerequisite>GR_T1MechTech</researchPrerequisite>
    <gestationCycles>4</gestationCycles>
    <formingTicks>15000</formingTicks>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>GR_Alloy</li>
          </thingDefs>
        </filter>
        <count>90</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>GR_Nanites</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>SubcoreBasic</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <GR_Mech_FF>1</GR_Mech_FF>
    </products>
    <descriptionHyperlinks>
      <ThingDef>GR_Mech_FF</ThingDef>
    </descriptionHyperlinks>
    <modExtensions>
      <li Class="SD.GrayRace.DefModExtensions.DefModExtension_MechAssemblyRecipe">
        <!-- 需要指定一个基础机体布局，这里指定护卫舰布局 -->
        <chassis>GR_Chassis_Corvette</chassis>
      </li>
    </modExtensions>
  </RecipeDef>

</Defs>
