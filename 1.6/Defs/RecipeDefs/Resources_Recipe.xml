<Defs>

  <!--灰潮源质-->
  <RecipeDef>
    <defName>GR_Extract</defName>
    <label>Extract Nanites x500</label>
    <description>Extract Nanites from Gray Flesh.</description>
    <jobString>Extract Nanites</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>300</workAmount>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>GR_GrayFlesh</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>GR_GrayFlesh</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <GR_Nanites>500</GR_Nanites>
    </products>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <displayPriority>1</displayPriority>
  </RecipeDef>

