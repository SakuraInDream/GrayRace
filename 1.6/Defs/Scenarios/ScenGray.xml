<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>GR_Crashlanded</defName>
    <label>Advance team</label>
    <description>你们三人作为殖民舰队的先遣队来到了这颗充满未知的边缘世界，殖民舰队很快就会到来并和你们建立联系，但你们仍然要依靠自己一草一木、一砖一瓦地建立起新的殖民地。在这个未知的星球上，将会有怎样的故事等待着你们来见证？
另外，好像有个已经宣称了这片星域的派系和你们不太友好，小心为上。</description>
    <scenario>
      <summary>三名灰裔殖民者在边缘世界建立殖民地的故事。</summary>
      <playerFaction Inherit="false">
        <def>PlayerFaction</def>
        <factionDef>Gray_PlayerFaction</factionDef>
      </playerFaction>
      <parts>

        <!-- Config pages -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>2</pawnCount>
          <pawnChoiceCount>4</pawnChoiceCount>
        </li>

        <!-- 到达方式-->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
          <visible>false</visible>
        </li>

        <!-- 初始资源 -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>2000</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>100</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentSpacer</thingDef>
          <count>10</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>GR_EnergyPDW</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>GR_RailPDW</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>GR_VoltSword</thingDef>
          <stuff>GR_Alloy</stuff>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>GR_Nanites</thingDef>
          <count>2000</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>GR_Alloy</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>GR_GrayCore</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>AIPersonaCore</thingDef>
        </li>

        <!-- 落点周围的资源 -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>

        <!-- 到处散落的资源 -->
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>Steel</thingDef>
          <count>500</count>
        </li>
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>Plasteel</thingDef>
          <count>500</count>
        </li>
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>Uranium</thingDef>
          <count>500</count>
        </li>

        <!--开局科技-->
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>GR_AlloyCasting</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>GR_BasicClothing</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Fabrication</project>
        </li>

        <!-- 游戏开始文本 -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>准备……建造……殖民地！</text>
          <closeSound>GameStartSting</closeSound>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
