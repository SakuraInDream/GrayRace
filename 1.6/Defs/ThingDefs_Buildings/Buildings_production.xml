<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--纳米重塑台-->

  <ThingDef ParentName="BenchBase">
    <defName>GR_NaniteReconfigurator</defName>
    <label>Nanite Reconfigurator</label>
    <description>A workbench equipped with advanced tools for producing technological marvels from simpler materials.</description>
    <thingClass>Building_WorkTable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0</Flammability>
      <WorkTableWorkSpeedFactor>1.5</WorkTableWorkSpeedFactor>
    </statBases>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <size>(5,2)</size>
    <costList>
      <GR_Alloy>200</GR_Alloy>
      <GR_Nanites>1000</GR_Nanites>
      <ComponentSpacer>5</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <recipes>
    </recipes>
    <graphicData>
      <texPath>Things/Building/Reconfigurator/Reconfigurator</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5.2,2.7)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Gray_Building</designationCategory>
    <uiOrder>100</uiOrder>
    <surfaceType>Item</surfaceType>
    <designationHotKey>Misc12</designationHotKey>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Fabrication</li>
    </researchPrerequisites>
  </ThingDef>

  <!--纳米变形器-->

  <ThingDef ParentName="BenchBase">
    <defName>GR_NaniteTransmuter</defName>
    <label>Nanite Transmuter</label>
    <description>A workbench equipped with advanced tools for producing technological marvels from simpler materials.</description>
    <thingClass>Building_WorkTable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Flammability>0</Flammability>
      <WorkTableWorkSpeedFactor>2.0</WorkTableWorkSpeedFactor>
    </statBases>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <size>(5,5)</size>
    <costList>
      <GR_Alloy>600</GR_Alloy>
      <GR_Nanites>1000</GR_Nanites>
      <ComponentSpacer>15</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>10000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <recipes>
    </recipes>
    <graphicData>
      <texPath>Things/Building/Transmuter/Transmuter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5.5,5.5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Gray_Building</designationCategory>
    <uiOrder>400</uiOrder>
    <surfaceType>Item</surfaceType>
    <designationHotKey>Misc12</designationHotKey>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>GR_NaniteTransmuter</li>
    </researchPrerequisites>
  </ThingDef>

  <!--聚变反应堆-->

  <ThingDef ParentName="BuildingBase">
    <defName>GR_FusionReactor</defName>
    <label>Heavy Element Fusion Reactor</label>
    <description>Produces power by consuming chemfuel. Must be periodically refueled by hand.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Reactor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,6)</drawSize>
      <drawOffset>(0,0,0.4)</drawOffset>
      <shadowData>
        <volume>(5,1,5)</volume>
        <offset>(-0.03,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.9</fillPercent>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <blockWind>true</blockWind>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>60000</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>20</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <size>(5,5)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <GR_Alloy>500</GR_Alloy>
      <GR_Nanites>1000</GR_Nanites>
      <ComponentSpacer>20</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-90000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
        <transmitsPower>true</transmitsPower>
        <soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>5</fuelConsumptionRate>
        <fuelCapacity>50.0</fuelCapacity>
        <fuelFilter>
          <categories>
            <li>StoneChunks</li>
          </categories>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>false</canEjectFuel>
      </li>
      <li Class="CompProperties_Spawner">
        <requiresPower>false</requiresPower>
        <thingToSpawn>Steel</thingToSpawn>
        <spawnCount>200</spawnCount>
        <spawnIntervalRange>
          <min>60000</min>
          <max>60000</max>
        </spawnIntervalRange>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <showMessageIfOwned>true</showMessageIfOwned>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>15</glowRadius>
        <glowColor>(0,175,255,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>15</heatPerSecond>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Gray_Building</designationCategory>
    <uiOrder>300</uiOrder>
    <designationHotKey>Misc4</designationHotKey>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>GR_FusionReactor</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>14</constructionSkillPrerequisite>
  </ThingDef>

  <!--被泰南气晕，培育仓盖子是单独渲染的-->

  <ThingDef ParentName="BuildingBase">
    <defName>GR_Incubator</defName>
    <label>Incubator</label>
    <description>A vat of fluid which can gestate an embryo or accelerate a child's growth.\n\nWhile growing or gestating, the vat must be fed with a constant supply of nutrition to provide the feedstock for growth. Gestating an embryo takes twice the nutrition of accelerating a child's growth.\n\nEmbryos are gestated for 9 days before a baby is formed. There is a risk of health complications.\n\nChild growth can only be accelerated up to age 18, but not beyond. While growing, a child's skills will slowly increase. Children raised in growth vats will have lower skills and gain fewer passions than normal.\n\nThe device uses chemical injections, electrical stimulation, and simple mechanite treatments to push the body to grow. Growth vats are often used to quickly manufacture engineered workers or warriors.</description>
    <thingClass>SD.GrayRace.ThingClasses.Building_GRIncubator</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Incubator/Incubator</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,2.5)</drawSize>
      <drawOffset>(0,0,0.7)</drawOffset>
    </graphicData>
    <uiIconPath>Things/Building/Incubator/Incubator_MenuIcon</uiIconPath>
    <rotatable>false</rotatable>
    <castEdgeShadows>true</castEdgeShadows>
    <size>(1,1)</size>
    <!-- 这里不用原版 bill 系统，避免被归入 PotentialBillGiver -->
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <GR_Alloy>150</GR_Alloy>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <blockWind>true</blockWind>
    <drawerType>MapMeshAndRealTime</drawerType>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <designationCategory>Gray_Building</designationCategory>
    <uiOrder>200</uiOrder>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <!-- <inspectorTabs>
      <li>ITab_BiosculpterNutritionStorage</li>
    </inspectorTabs> -->
    <researchPrerequisites>
      <li>GrowthVats</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <haulToContainerDuration>120</haulToContainerDuration>
      <workTableRoomRole>Laboratory</workTableRoomRole>
      <buildingTags>
        <li>Biotech</li>
      </buildingTags>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>GR_Nanites</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <thingDefs>
            <li>GR_Nanites</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
      <!-- 借用一下生科的培育器 -->
      <mechGestatorCylinderGraphic>
        <texPath>Things/Building/Incubator/IncubatorGlass</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(1.5,2.5)</drawSize>
        <!-- <drawOffset>(-0.01,0,0.7)</drawOffset> -->
        <drawOffset>(0,0,0.7)</drawOffset>
        <shaderType>Transparent</shaderType>
      </mechGestatorCylinderGraphic>
      <mechGestatorTopGraphic>
        <texPath>Things/Building/Incubator/IncubatorTop</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(1.5,2.5)</drawSize>
        <drawOffset>(0,0,0.7)</drawOffset>
      </mechGestatorTopGraphic>
    </building>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <placeWorkers>
      <li>SD.GrayRace.PlaceWorkers.PlaceWorker_IncubatorTop</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>600</basePowerConsumption>
        <idlePowerDraw>10</idlePowerDraw>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
  </ThingDef>

  <!--灰裔干船坞-->

  <ThingDef ParentName="BenchBase">
    <defName>GR_Drydock</defName>
    <label>Gray Drydock</label>
    <description>A modular drydock used to assemble Gray warship-bodied mechanoids from predefined fitting packages.</description>
    <thingClass>SD.GrayRace.ThingClasses.Building_GR_Drydock</thingClass>
    <tickerType>Normal</tickerType>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <size>(5,5)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.85</fillPercent>
    <graphicData>
      <texPath>Things/Building/Production/MechGestatorLarge</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(6,5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>1800</MaxHitPoints>
      <WorkToBuild>16000</WorkToBuild>
      <Flammability>0</Flammability>
      <WorkTableWorkSpeedFactor>1.25</WorkTableWorkSpeedFactor>
    </statBases>
    <costList>
      <GR_Alloy>400</GR_Alloy>
      <GR_Nanites>200</GR_Nanites>
      <ComponentSpacer>10</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="SD.GrayRace.Comps.CompPropertiesGrayMechAssemblyBay" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>8000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <inspectorTabs>
      <li>SD.GrayRace.ITabs.ITab_GrayMechDrydock</li>
      <li>SD.GrayRace.ITabs.ITab_GrayMechDrydockQueue</li>
    </inspectorTabs>
    <building>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Gray_Building</designationCategory>
    <uiOrder>350</uiOrder>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
  </ThingDef>

