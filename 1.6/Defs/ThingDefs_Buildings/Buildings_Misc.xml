<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--科研枢纽下行链路-->

  <ThingDef ParentName="BuildingBase">
    <defName>GR_ScienceNexus</defName>
    <label>Science Nexus DownLink</label>
    <description>Increases research speed when placed near hi-tech research bench and unlocks new research projects. Each research bench can only use one multi-analyzer.</description>
    <graphicData>
      <texPath>Things/Building/Misc/ScienceNexus</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.5</drawSize>
      <drawOffset>(0,0,0.2)</drawOffset>
    </graphicData>
    <uiIconScale>0.85</uiIconScale>
    <researchPrerequisites>
      <li>GR_ScienceNexus</li>
    </researchPrerequisites>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <designationHotKey>Misc4</designationHotKey>
    <designationCategory>Gray_Building</designationCategory>
    <uiOrder>500</uiOrder>
    <minifiedDef>MinifiedThing</minifiedDef>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <GR_Alloy>200</GR_Alloy>
      <GR_Nanites>40</GR_Nanites>
      <ComponentSpacer>10</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>800</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <ResearchSpeedFactor>0.4</ResearchSpeedFactor>
        </statOffsets>
        <maxSimultaneous>2</maxSimultaneous>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
  </ThingDef>

  <!--战略指挥中心转发终端-->

  <ThingDef ParentName="BuildingBase">
    <defName>GR_SCC_BandNode</defName>
    <label>SCC Signal Relay Terminal</label>
    <description>A terminal that receives signals from the Strategic Coordination Center. It must be tuned to a specific Mechanitor. This will add 50 bandwidth to that mechanitor's total bandwidth, allowing them to control more mechanoids. The terminal can be quickly tuned to a Mechanitor immediately after construction. However, retuning it to a different Mechanitor takes considerably longer.</description>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>
    <drawerType>MapMeshAndRealTime</drawerType>
    <fillPercent>0.4</fillPercent>
    <graphicData>
      <texPath>Things/Building/Misc/SCC</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.5,2.5)</drawSize>
      <drawOffset>(0,0,0.2)</drawOffset>
      <shadowData>
        <volume>(1.5, 0.35, 1.2)</volume>
        <offset>(0, 0, -0.15)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <buildingTags>
        <li>Biotech</li>
      </buildingTags>
    </building>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <designationCategory>Gray_Building</designationCategory>
    <uiOrder>600</uiOrder>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <size>(2,2)</size>
    <costList>
      <GR_Alloy>300</GR_Alloy>
      <GR_Nanites>100</GR_Nanites>
      <ComponentSpacer>10</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>GR_T4MechTech</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>5000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_BandNode">
        <hediff>GR_SCC_BandNode_Hediff</hediff>
        <untunedEffect>BandNodeUntuned</untunedEffect>
        <tuningEffect>BandNodeTuning</tuningEffect>
        <tunedEffect>BandNodeTuned</tunedEffect>
        <retuningEffect>BandNodeRetuning</retuningEffect>
        <tuningCompleteSound>BandNodeTuning_Complete</tuningCompleteSound>
        <powerConsumptionIdle>100</powerConsumptionIdle>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_BandNode</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
  </ThingDef>

