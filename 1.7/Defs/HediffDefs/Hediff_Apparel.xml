<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--悬浮装置-->
  <HediffDef>
    <defName>GR_Suspensiondevice</defName>
    <label>Suspension device</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>.</description>
    <isBad>false</isBad>
    <preventsDeath>false</preventsDeath>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <MoveSpeed>3</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>GR_Longjump</li>
        </abilityDefs>
      </li>
    </comps>
  </HediffDef>

  <!--WD40-->
  <HediffDef>
    <defName>GR_WD40</defName>
    <label>WD40</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Wow, it's WD40!</description>
    <isBad>false</isBad>
    <preventsDeath>false</preventsDeath>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.1</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
  </HediffDef>

</Defs>
