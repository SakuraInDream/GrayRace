<Defs>

  <!--能量冲（流光）-->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>GR_EnergyPDW</defName>
    <label>Gray Energy PDW</label>
    <description>Gray standard energy personal defense weapon, also known as Flowglow. Most of its compact frame is devoted to the particle accelerator, achieving truly instant-fire capability. However, its insufficient power limits it to humans and smaller enemies, so it is not very popular among the Gray, who frequently encounter bizarre alien lifeforms. It is generally issued to non-combat personnel.</description>
    <graphicData>
      <texPath>Things/Item/Weapon/Energy/Energy_PDW</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <equippedAngleOffset>45</equippedAngleOffset>
    <soundInteract>Interact_SMG</soundInteract>
    <weaponClasses>
      <li>ShortShots</li>
      <li>RangedHeavy</li>
    </weaponClasses>
    <recipeMaker>
      <researchPrerequisites>
        <li>GR_EnergyWeapon</li>
      </researchPrerequisites>
