  <!-- ================ 机关炮 ================ -->
  <ThingDef ParentName="LightMechanoidGunRanged">
    <defName>GR_MechWeapon_Autocannon1_S</defName>
    <label>Autocannon</label>
    <description>A large-caliber ballistic weapon that fires explosive shells. These autocannons are prized mainly for their extremely high rate of fire.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Weapon/MechFloating/Floating_MassDriver_S</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.9</AccuracyTouch>
      <AccuracyShort>0.9</AccuracyShort>
      <AccuracyMedium>0.3</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
    </statBases>
    <weaponTags/>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_GR_MechAutocannon1_S</defaultProjectile>
        <warmupTime>0.21</warmupTime>
        <defaultCooldownTime>0.64</defaultCooldownTime>
        <range>14.9</range>
        <burstShotCount>2</burstShotCount>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <soundCast>Shot_Slugthrower</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

