<Defs>

  <!--机械师软甲-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Gray_Apparel_MechanitorISA</defName>
    <description>The Laminar Warweave is the signature combat bodysuit of Gray mechanitors and their final insurance. Its main structure is made of active Gray Tide Zro, which actively coordinates the whole body and dynamically dissipates incoming impacts, effectively solving the problem of mechanitors being accidentally hit by stray fire on the battlefield. Since some cuts do not affect the suit's performance, high-cut bodysuit variants once appeared—and were unexpectedly popular.</description>
    <label>Gray mechanitor ISA</label>
    <techLevel>Spacer</techLevel>
    <thingCategories>
      <li>GR_ApparelArmor</li>
    </thingCategories>
    <possessionCount>1</possessionCount>
    <recipeMaker>
      <researchPrerequisites>
        <li>GR_CombatClothing</li>
        <li>GR_T2MechTech</li>
      </researchPrerequisites>
      <recipeUsers>
        <li>GR_NaniteReconfigurator</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <graphicData>
      <texPath>Apparel/Mechanitor/Gray_MechanitorISA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <costStuffCount>40</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <GR_Alloy>60</GR_Alloy>
      <GR_Nanites>80</GR_Nanites>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToMake>60000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
      <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MechBandwidth>12</MechBandwidth>
      <MechFormingSpeed>0.5</MechFormingSpeed>
      <MechRepairSpeed>0.5</MechRepairSpeed>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Hands</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Mechanitor/Gray_MechanitorISA</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>GR_Combat</li>
        <li>GR_MechanitorArmor</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <colorGenerator Class="ColorGenerator_White" />
  </ThingDef>

  <!--通用软甲-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Gray_Apparel_UniversalISA</defName>
