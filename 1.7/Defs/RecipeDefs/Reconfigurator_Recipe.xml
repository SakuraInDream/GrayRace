  <RecipeDef>
    <defName>GR_Make_GrayCore</defName>
    <label>make Nanite Core</label>
    <description>Make Nanite Core.</description>
    <jobString>Making Nanite Core.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>30000</workAmount>
    <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
    <recipeUsers>
      <li>GR_NaniteReconfigurator</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>GR_Nanites</li>
          </thingDefs>
        </filter>
        <count>100</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>GR_Alloy</li>
          </thingDefs>
        </filter>
        <count>100</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>GR_Nanites</li>
        <li>GR_Alloy</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <GR_GrayCore>1</GR_GrayCore>
    </products>
    <skillRequirements>
      <Crafting>12</Crafting>
      <Intellectual>12</Intellectual>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <displayPriority>3</displayPriority>
  </RecipeDef>

