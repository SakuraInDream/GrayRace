<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 没做超空间引擎的槽，所以少 1 个槽，不懂 RW 里效果怎么体现 -->
  <SD.GrayRace.Defs.GRMechChassisDef Name="GR_ChassisBase" Abstract="True">
    <requiredComponentSlots>
      <li>
        <!-- key 是用来保存数据的，让模块知道安装在哪个槽位里，仿群星设计 -->
        <key>POWER_CORE_01</key>
        <label>Reactor</label>
        <slotDef>GR_MechSlot_PowerCore</slotDef>
        <anchorBodyPart>Reactor</anchorBodyPart>
        <uiOrder>10</uiOrder>
      </li>
      <li>
        <key>THRUSTER_01</key>
        <label>Thruster</label>
        <slotDef>GR_MechSlot_Thruster</slotDef>
        <anchorBodyPart>MechanicalFoot</anchorBodyPart>
        <uiOrder>20</uiOrder>
      </li>
    </requiredComponentSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <!-- 都是仿群星的设计 -->
  <!-- 每制作一个 ChassisDef 就要创建一个 RecipeDef 绑定机械体 -->
  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Corvette</defName>
    <label>Frigate</label>
    <description>The frigate is one of the most basic warship types. It is armed and can engage enemies.</description>
    <pawnKindDef>GR_Mech_FF</pawnKindDef>
    <designerPreviewPath>Race/Mech/FF_south</designerPreviewPath>
    <fixedWorkTicks>20000</fixedWorkTicks>
    <uiOrder>0</uiOrder>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <!-- 像护卫舰只支持核心区段 -->
      <li>GR_MechSection_Mid</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Frigate</defName>
    <label>Torpedo Boat</label>
    <description>The torpedo boat is an advanced derivative of the frigate, dedicated to launching torpedoes. They are slower and more fragile, but can deliver devastating strikes against large targets.</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_FF</pawnKindDef>
    <designerPreviewPath>Race/Mech/FF_south</designerPreviewPath>
    <fixedWorkTicks>30000</fixedWorkTicks>
    <uiOrder>1</uiOrder>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Mid</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Destroyer</defName>
    <label>Destroyer</label>
    <description>Destroyers use a two-section design, allowing a wide variety of strategic armaments.</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_DD</pawnKindDef>
    <designerPreviewPath>Race/Mech/DD_south</designerPreviewPath>
    <fixedWorkTicks>40000</fixedWorkTicks>
    <uiOrder>2</uiOrder>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Bow</li>
      <li>GR_MechSection_Stern</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Cruiser</defName>
    <label>Cruiser</label>
    <description>Cruisers use a three-section design and can be freely refitted with additional modules if one is willing to pay.</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_CA</pawnKindDef>
    <designerPreviewPath>Race/Mech/CA_south</designerPreviewPath>
    <fixedWorkTicks>80000</fixedWorkTicks>
    <uiOrder>3</uiOrder>
    <researchPrerequisites>
      <li>GR_T3MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Bow</li>
      <li>GR_MechSection_Mid</li>
      <li>GR_MechSection_Stern</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Battleship</defName>
    <label>Battleship</label>
    <description>Battleships carry unmatched firepower and have the largest hull size, but they are expensive and poorly maneuverable.</description>
    <!-- 这两个绑定对应的机械体 -->
    <pawnKindDef>GR_Mech_BB</pawnKindDef>
    <designerPreviewPath>Race/Mech/CA_south</designerPreviewPath>
    <fixedWorkTicks>160000</fixedWorkTicks>
    <uiOrder>4</uiOrder>
    <researchPrerequisites>
      <li>GR_T4MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <!-- 支持哪些区段（GRMechSectionSlotDef） -->
      <li>GR_MechSection_Bow</li>
      <li>GR_MechSection_Mid</li>
      <li>GR_MechSection_Stern</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Titan</defName>
    <label>Titan</label>
    <description>These giant warships are the pride of the fleet. Titans carry a variety of weapons and usually serve as flagships.</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_TT</pawnKindDef>
    <designerPreviewPath>Race/Mech/CA_south</designerPreviewPath>
    <fixedWorkTicks>320000</fixedWorkTicks>
    <uiOrder>5</uiOrder>
    <researchPrerequisites>
      <li>GR_T5MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Bow</li>
      <li>GR_MechSection_Mid</li>
      <li>GR_MechSection_Stern</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>

  <SD.GrayRace.Defs.GRMechChassisDef ParentName="GR_ChassisBase">
    <defName>GR_Chassis_Juggernaut</defName>
    <label>Juggernaut</label>
    <description>These colossal constructs are both ships and space stations. The juggernaut is an enormous mobile station that can repair and build ships, serving as a forward base during offensive campaigns.</description>
    <!-- TODO -->
    <pawnKindDef>GR_Mech_JG</pawnKindDef>
    <designerPreviewPath>Race/Mech/CA_south</designerPreviewPath>
    <fixedWorkTicks>640000</fixedWorkTicks>
    <uiOrder>6</uiOrder>
    <researchPrerequisites>
      <li>GR_T6MechTech</li>
    </researchPrerequisites>
    <sectionSlots>
      <li>GR_MechSection_Mid</li>
    </sectionSlots>
  </SD.GrayRace.Defs.GRMechChassisDef>
</Defs>
