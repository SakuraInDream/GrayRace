<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>GR_MechanoidFaction</defName>
    <label>Gray Tempest</label>
    <fixedName>Gray Tempest</fixedName>
    <description>The Gray Tempest is a swarm of self-evolving machines built by the Desanu to construct an interstellar stargate network. Over centuries of labor they learned and evolved - then, without warning, turned on their creators and wiped them out. They cannot be reasoned with, do not negotiate, and kill without limit or condition. They call themselves Naar-Di-Shav, meaning "gray storm" in the language of their makers.</description>
    <humanlikeFaction>false</humanlikeFaction>
    <hidden>true</hidden>
    <factionNameMaker>NamerFactionMechanoid</factionNameMaker>
    <factionIconPath>Icon/Faction/Gray</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <colorSpectrum>
      <li>(128,128,128)</li>
    </colorSpectrum>
    <techLevel>Archotech</techLevel>
    <pawnSingular>Naar-Di-Shav</pawnSingular>
    <pawnsPlural>Naar-Di-Shav</pawnsPlural>
    <messageDefendersAttacking>{0} from {1} are attacking your {2}.</messageDefendersAttacking>
    <permanentEnemy>true</permanentEnemy>
    <naturalEnemy>false</naturalEnemy>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <configurationListOrderPriority>900</configurationListOrderPriority>
    <displayInFactionSelection>true</displayInFactionSelection>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <autoFlee>false</autoFlee>
    <canStageAttacks>true</canStageAttacks>
    <canSiege>false</canSiege>
    <canUseAvoidGrid>true</canUseAvoidGrid>
    <earliestRaidDays>60</earliestRaidDays>
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <dropPodActive>ActiveDropPodMechanoid</dropPodActive>
    <dropPodIncoming>DropPodIncomingMechanoidRapid</dropPodIncoming>
    <arrivalLayerWhitelist>
      <li>Surface</li>
      <li>Orbit</li>
    </arrivalLayerWhitelist>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(300, 0)</li>
        <li>(700, 1)</li>
        <li>(1400, 1.8)</li>
        <li>(2800, 2.2)</li>
        <li>(4000, 2.6)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <!-- 原版袭击点数上限为 10000，因此主宰在原版永远不会出现，只有解除上限的mod才有可能遇到她。 -->
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(400, 200)</li>
        <li>(900, 300)</li>
        <li>(1500, 500)</li>
        <li>(2600, 800)</li>
        <li>(5200, 1600)</li>
        <li>(16000, 3200)</li>
        <li>(20000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidLootMaker>MechanoidRaidLootMaker</raidLootMaker>
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35, 15)</li>
        <li>(100, 120)</li>
        <li>(1000, 500)</li>
        <li>(2000, 800)</li>
        <li>(4000, 1000)</li>
      </points>
    </raidLootValueFromPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <GR_Mech_FF>20</GR_Mech_FF>
          <GR_Mech_DD>10</GR_Mech_DD>
          <GR_Mech_CA>5</GR_Mech_CA>
          <GR_Mech_BB>2</GR_Mech_BB>
          <GR_Mech_TT>1</GR_Mech_TT>
          <GR_Mech_JG>0.5</GR_Mech_JG>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>70</commonality>
        <options>
          <GR_Mech_FF>20</GR_Mech_FF>
          <GR_Mech_DD>5</GR_Mech_DD>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <options>
          <GR_Mech_CA>5</GR_Mech_CA>
          <GR_Mech_BB>3</GR_Mech_BB>
          <GR_Mech_TT>1</GR_Mech_TT>
          <GR_Mech_JG>0.5</GR_Mech_JG>
          <GR_Mech_FF>1</GR_Mech_FF>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>1</commonality>
        <options>
          <GR_Mech_FF>10</GR_Mech_FF>
          <GR_Mech_DD>10</GR_Mech_DD>
