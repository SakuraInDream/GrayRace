<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <SD.GrayRace.Defs.GRMechPowerCoreModuleDef Name="GR_MechModule_ReactorBase" Abstract="True">
    <compatibleSlots>
      <li>GR_MechSlot_PowerCore</li>
    </compatibleSlots>
    <anchorBodyPart>Reactor</anchorBodyPart>
  </SD.GrayRace.Defs.GRMechPowerCoreModuleDef>

  <SD.GrayRace.Defs.GRMechPowerCoreModuleDef Name="GR_MechModule_ReactorTier_Fission" ParentName="GR_MechModule_ReactorBase" Abstract="True">
    <label>Fission Reactor</label>
    <description>Provides basic power to mechanoids through controlled nuclear fission, but also brings constant waste heat and nuclear waste disposal pressure.</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_1</iconPath>
    <researchPrerequisites>
      <li>GR_T1MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Reactor_Fission</researchUnlockGroup>
    <uiOrder>4010</uiOrder>
  </SD.GrayRace.Defs.GRMechPowerCoreModuleDef>

  <SD.GrayRace.Defs.GRMechPowerCoreModuleDef Name="GR_MechModule_ReactorTier_Fusion" ParentName="GR_MechModule_ReactorBase" Abstract="True">
    <label>Fusion Reactor</label>
    <description>Nuclear fusion delivers higher output more stably. It significantly raises the power ceiling while avoiding most inherent risks of fission systems.</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_2</iconPath>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Reactor_Fusion</researchUnlockGroup>
    <uiOrder>4020</uiOrder>
  </SD.GrayRace.Defs.GRMechPowerCoreModuleDef>

  <SD.GrayRace.Defs.GRMechPowerCoreModuleDef Name="GR_MechModule_ReactorTier_ColdFusion" ParentName="GR_MechModule_ReactorBase" Abstract="True">
    <label>Cold Fusion Reactor</label>
    <description>Maintains fusion at relatively low temperatures, making a new generation of efficient reactors possible and allowing the chassis to support high-load combat modules with ease.</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_3</iconPath>
    <researchPrerequisites>
      <li>GR_T3MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Reactor_ColdFusion</researchUnlockGroup>
    <uiOrder>4030</uiOrder>
  </SD.GrayRace.Defs.GRMechPowerCoreModuleDef>

  <SD.GrayRace.Defs.GRMechPowerCoreModuleDef Name="GR_MechModule_ReactorTier_Antimatter" ParentName="GR_MechModule_ReactorBase" Abstract="True">
    <label>Antimatter Reactor</label>
    <description>Harnesses the immense energy released by matter-antimatter annihilation. Its power density far exceeds conventional fusion reactors and can reliably drive heavier combat configurations.</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_4</iconPath>
    <researchPrerequisites>
      <li>GR_T4MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Reactor_Antimatter</researchUnlockGroup>
    <uiOrder>4040</uiOrder>
  </SD.GrayRace.Defs.GRMechPowerCoreModuleDef>

  <SD.GrayRace.Defs.GRMechPowerCoreModuleDef Name="GR_MechModule_ReactorTier_ZeroPoint" ParentName="GR_MechModule_ReactorBase" Abstract="True">
    <label>Zero-Point Reactor</label>
    <description>Draws zero-point energy directly from vacuum fluctuations, compressing an almost inexhaustible power reserve into a standardized shipboard power core.</description>
    <iconPath>Icon/ShipParts/ship_part_reactor_5</iconPath>
    <researchPrerequisites>
      <li>GR_T5MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Reactor_ZeroPoint</researchUnlockGroup>
    <uiOrder>4050</uiOrder>
  </SD.GrayRace.Defs.GRMechPowerCoreModuleDef>

  <SD.GrayRace.Defs.GRMechPowerCoreModuleDef Name="GR_MechModule_ReactorTier_DarkMatter" ParentName="GR_MechModule_ReactorBase" Abstract="True">
    <label>Dark Matter Reactor</label>
    <description>These power cores seem to draw energy directly from dark matter. Their actual output exceeds anything conventional physical models can explain.</description>
    <iconPath>Icon/ShipParts/ship_part_dark_matter_power_core</iconPath>
    <researchPrerequisites>
      <li>GR_T6MechTech</li>
    </researchPrerequisites>
    <researchUnlockGroup>GR_Reactor_DarkMatter</researchUnlockGroup>
    <uiOrder>4060</uiOrder>
  </SD.GrayRace.Defs.GRMechPowerCoreModuleDef>

