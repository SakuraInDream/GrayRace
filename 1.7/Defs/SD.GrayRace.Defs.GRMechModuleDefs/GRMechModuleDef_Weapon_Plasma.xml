      <li>GR_MechModule_Plasma2_S</li>
    </upgradesTo>
    <compatibleSlots>
      <li>GR_MechSlot_SmallTurret</li>
    </compatibleSlots>
    <costList>
      <GR_Alloy>23</GR_Alloy>
    </costList>
