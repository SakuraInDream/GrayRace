  <!-- 等离子发射器 -->
  <SD.GrayRace.Defs.GRMechModuleDef Name="GR_MechModule_Plasma1Base" Abstract="True">
    <label>等离子发射器</label>
    <description>可以向目标发射毁灭性的高能等离子球体的武器。这种等离子抛射体在对付大型舰船的装甲时特别有效。</description>
    <iconPath>Icon/ShipParts/ship_part_laser_1</iconPath>
    <slotFamily>PlasmaThrower</slotFamily>
    <researchPrerequisites>
      <li>GR_T2MechTech</li>
    </researchPrerequisites>
    <uiOrder>0</uiOrder>
  </SD.GrayRace.Defs.GRMechModuleDef>

