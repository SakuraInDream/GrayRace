<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <StatDef>
    <defName>GRStat_NaniteMax</defName>
    <label>Spare Nanite capacity</label>
    <description>The maximum amount of spare nanites the Gray can store in her body.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>500</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <workerClass>SD.GrayRace.StatWorkers.StatWorker_GrayRace</workerClass>

    <!-- <parts>

    </parts> -->
  </StatDef>

  <StatDef>
    <defName>GRStat_NaniteRegenRate</defName>
    <label>Spare Nanite recovery rate</label>
    <description>The number of nanites the Gray automatically recovers per second.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>1.0</defaultBaseValue>
    <toStringStyle>FloatTwo</toStringStyle>
    <workerClass>SD.GrayRace.StatWorkers.StatWorker_GrayRace</workerClass>

    <capacityFactors>
      <li>
        <capacity>BloodPumping</capacity>
      </li>
    </capacityFactors>

    <parts>
      <!-- 高速治疗消耗 Nanites -->
      <li Class="SD.GrayRace.StatWorkers.StatPart_NaniteDrain" />

      <!-- 根据 Need 自然恢复 Nanites -->
      <li Class="SD.GrayRace.StatWorkers.StatPart_NaniteGen">
        <curve>
          <points>
            <!-- 无能量时为 0 -->
            <li>(0, 0)</li>
            <li>(0.01, 0.02)</li>
            <li>(0.1, 0.2)</li>
            <li>(0.2, 0.4)</li>
            <li>(0.3, 0.6)</li>
            <li>(0.4, 0.8)</li>
            <li>(0.5, 1)</li>
          </points>
        </curve>
      </li>
    </parts>
  </StatDef>

  <StatDef>
    <defName>GRStat_OverclockMaxLevel</defName>
    <label>Overclock Limit</label>
    <description>The maximum overclock percentage this body part can currently reach.</description>
    <category>BasicsPawn</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <workerClass>SD.GrayRace.StatWorkers.StatWorker_GrayRace</workerClass>
  </StatDef>
</Defs>
