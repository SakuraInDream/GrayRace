    <defName>GR_MechWeapon_Autocannon1_S</defName>
    <statBases>
      <SightsEfficiency>1</SightsEfficiency>
      <ShotSpread>0.01</ShotSpread>
      <SwayFactor>0</SwayFactor>
    </statBases>
    <Properties>
      <verbClass>CombatExtended.Verb_ShootCE</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Bullet_GR_MechAutocannon1_S_CE</defaultProjectile>
      <warmupTime>0.21</warmupTime>
      <defaultCooldownTime>0.64</defaultCooldownTime>
      <range>29.9</range>
      <burstShotCount>2</burstShotCount>
      <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
      <soundCast>Shot_Shotgun</soundCast>
