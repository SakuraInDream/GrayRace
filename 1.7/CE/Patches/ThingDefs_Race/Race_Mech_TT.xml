<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ======== 护卫舰 ======== -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Mech_TT"]</xpath>
    <value>
      <comps>
        <li Class="CombatExtended.CompProperties_ArmorDurability">
          <Durability>19200</Durability>
          <Regenerates>true</Regenerates>
          <RegenInterval>120</RegenInterval>
          <RegenValue>192</RegenValue>
          <Repairable>true</Repairable>
          <RepairIngredients>
            <GR_Alloy>160</GR_Alloy>
          </RepairIngredients>
          <RepairTime>60</RepairTime>
          <RepairValue>9600</RepairValue>
          <CanOverHeal>true</CanOverHeal>
          <MaxOverHeal>12800</MaxOverHeal>
          <MinArmorPct>0.50</MinArmorPct>
        </li>
      </comps>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GR_Mech_TT"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>128</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GR_Mech_TT"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>4096</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GR_Mech_TT"]/statBases</xpath>
    <value>
      <NightVisionEfficiency>0.80</NightVisionEfficiency>
      <ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>
      <AimingAccuracy>1.5</AimingAccuracy>
      <MeleeCritChance>5</MeleeCritChance>
      <CarryWeight>700</CarryWeight>
      <CarryBulk>700</CarryBulk>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GR_Mech_TT"]/tools</xpath>
    <value>
      <tools>
        <li Class="CombatExtended.ToolCE">
          <label>fist</label>
          <capacities>
            <li>GR_NanoScratch</li>
          </capacities>
          <power>160</power>
          <cooldownTime>2</cooldownTime>
          <armorPenetrationSharp>64</armorPenetrationSharp>
          <armorPenetrationBlunt>128</armorPenetrationBlunt>
        </li>
      </tools>
    </value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="GR_Mech_TT"]</xpath>
    <value>
      <li Class="CombatExtended.PartialArmorExt">
        <stats>
          <li>
            <ArmorRating_Sharp>10</ArmorRating_Sharp>
            <parts>
              <li>GR_ArmoredBelt</li>
            </parts>
          </li>
          <li>
            <ArmorRating_Blunt>20</ArmorRating_Blunt>
            <parts>
              <li>GR_ArmoredBelt</li>
            </parts>
          </li>
          <li>
            <ArmorRating_Sharp>6</ArmorRating_Sharp>
            <parts>
              <li>GR_AntiTorpedoBulge</li>
            </parts>
          </li>
          <li>
            <ArmorRating_Blunt>12</ArmorRating_Blunt>
            <parts>
              <li>GR_AntiTorpedoBulge</li>
            </parts>
          </li>
        </stats>
      </li>
    </value>
  </Operation>
</Patch>
