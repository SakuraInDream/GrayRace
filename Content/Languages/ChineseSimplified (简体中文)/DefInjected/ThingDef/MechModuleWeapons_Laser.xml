  <!-- EN: Perdition Beam -->
  <GR_MechWeapon_TitanLance.label>炼狱射线</GR_MechWeapon_TitanLance.label>
  <!-- EN: A massive array of series-linked energy amplification conduits capable of firing a beam of unprecedented power. Its size means only Titan-class starships can mount it. -->
