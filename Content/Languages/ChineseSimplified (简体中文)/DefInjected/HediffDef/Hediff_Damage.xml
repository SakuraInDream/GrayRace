  <GR_Disintegration_Corrosion.stages.Infiltration.label>渗透</GR_Disintegration_Corrosion.stages.Infiltration.label>
  <!-- EN: Corrosion -->
  <GR_Disintegration_Corrosion.stages.Corrosion.label>侵蚀</GR_Disintegration_Corrosion.stages.Corrosion.label>
  <!-- EN: Degradation -->
  <GR_Disintegration_Corrosion.stages.Degradation.label>退化</GR_Disintegration_Corrosion.stages.Degradation.label>
  <!-- EN: Collapse -->
  <GR_Disintegration_Corrosion.stages.Collapse.label>崩溃</GR_Disintegration_Corrosion.stages.Collapse.label>
  <!-- EN: Annihilation -->
  <GR_Disintegration_Corrosion.stages.Annihilation.label>湮灭</GR_Disintegration_Corrosion.stages.Annihilation.label>
  
  <!-- EN: Nanite Corrosion -->
  <GR_Nanite_Corrosion.label>纳米侵蚀</GR_Nanite_Corrosion.label>
  <!-- EN: This lethal nanite infection progressively disassembles the target's molecular structure, inducing excruciating neural pain while systematically degrading defensive capabilities. Affected subjects undergo a cascading failure—from localized corrosion to total systemic collapse. -->
  <GR_Nanite_Corrosion.description>这种致命的纳米感染会逐步分解目标的结构，在引发剧烈神经疼痛的同时，蚕食他们的装甲。受影响的个体将会经历他们生命中最大的痛苦——从局部侵蚀到全面崩溃。</GR_Nanite_Corrosion.description>
